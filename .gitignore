node_modules/
dist/
build/
.astro/

# Where scripts/build-atomic.mjs assembles a build before publishing it. The
# script removes its own; one only survives a build that was killed.
.dist-build-*/
.next/
coverage/
.video-output/
video/agents-hyperframes/app/
video/agents-hyperframes/.hyperframes/
video/agents-hyperframes/snapshots/
video/agents-hyperframes/renders/

# Secrets — never committed
.env
.env.*
!.env.example
.dev.vars
*.pem
*.key

# OS / editor noise
.DS_Store
Thumbs.db

# Natural Earth source data — downloaded on demand by scripts/build-gazetteer.mjs
# and by hand for the land mask. 5.8 MB that only a data refresh ever reads;
# the generated gazetteer.json and land-mask.ts are what get committed.
scripts/ne_10m_populated_places_simple.geojson
scripts/ne_110m_admin_0_countries.geojson

# What Blender writes while a model is built (docs/world.md, "The models").
# The scripts in art/ are the source; scripts/build-world-assets.mjs turns their
# output into the committed files in src/assets/world/.
art/*/out/
art/*/cache/
art/*/work/
art/*/work_*/
art/*/tmp/
__pycache__/
