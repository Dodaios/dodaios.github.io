{
  "name": "dodaios-website",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "astro dev --background",
    "dev:status": "astro dev status",
    "dev:logs": "astro dev logs",
    "dev:stop": "astro dev stop",
    "build": "node scripts/build-atomic.mjs",
    "preview": "astro preview",
    "check": "astro check",
    "video:agents:studio": "npm --prefix video/agents-hyperframes run dev",
    "video:agents:check": "npm --prefix video/agents-hyperframes run check",
    "video:agents:render": "node video/agents-hyperframes/render.mjs",
    "check:style": "node scripts/check-style.mjs",
    "check:geocode": "node scripts/test-geocode.mjs",
    "data:stargazers": "node scripts/fetch-stargazers.mjs",
    "data:app-catalog": "node scripts/extract-app-catalog.mjs",
    "data:repo-map": "node scripts/fetch-repo-map.mjs",
    "data:gazetteer": "node scripts/build-gazetteer.mjs",
    "data:land-mask": "node scripts/build-land-mask.mjs",
    "verify": "npm run check:style && npm run check:geocode && astro check && npm run build"
  },
  "dependencies": {
    "@astrojs/react": "^6.0.4",
    "@astrojs/sitemap": "^3.7.3",
    "@tailwindcss/vite": "^4.3.3",
    "astro": "^7.2.9",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "tailwindcss": "^4.3.3",
    "three": "^0.180.0"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.10",
    "@gltf-transform/core": "^4.5.1",
    "@gltf-transform/extensions": "^4.5.1",
    "@gltf-transform/functions": "^4.5.1",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@types/three": "^0.185.4",
    "js-yaml": "^5.4.1",
    "meshoptimizer": "^1.3.0",
    "sharp": "^0.35.5",
    "typescript": "^6.0.3"
  }
}
