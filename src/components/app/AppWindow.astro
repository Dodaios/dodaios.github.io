---
/**
 * The product's window, at page size.
 *
 * A frame in real markup: a title bar, three dots, the app's near-black
 * ground. The type inside it is the page's type and the list inside it is the
 * whole list. (Until 2026-11-11 the front page drew the same frame as a scaled
 * miniature; that went with the front page's rebuild.)
 *
 * NOT SHARED WITH THE MINIATURE, ON PURPOSE. That one measures everything in
 * design pixels against a 1440-wide canvas so it can be scaled to any size; this
 * one measures in the page's own units so its text can be selected, searched and
 * read by a screen reader. A single component serving both would have to carry
 * both unit systems, and the first person to tidy it would collapse them.
 *
 * See docs/detail-pages.md and src/styles/app.css.
 */

interface Props {
  /** What the title bar says. The app puts the product name there. */
  title?: string;
  class?: string;
}

const { title = "Dodaios", class: className = "" } = Astro.props;
---

<div class={`app-window ${className}`.trim()}>
  {/*
    The bar is chrome, not content: a screen reader announcing "Dodaios,
    three buttons" before every list would be reading out the picture frame. The
    window's content is the slot, and that is not hidden.
  */}
  <div class="app-window__bar" aria-hidden="true">
    <span class="app-window__dots">
      <span class="app-window__dot"></span>
      <span class="app-window__dot"></span>
      <span class="app-window__dot"></span>
    </span>
    <span class="app-window__title">{title}</span>
  </div>

  <div class="app-window__body">
    <slot />
  </div>
</div>
