---
/**
 * The page shell. Every route extends this one.
 *
 * It owns <head>, the stylesheet and the page chrome, and nothing else —
 * layout belongs to Container (docs/layout.md), looks belong to the tokens
 * (docs/design.md).
 *
 * PageChrome is here rather than in a section because the rails run the whole
 * page. Assembled per section they would come out as segments with seams, and
 * the seams are the first thing the eye finds. See docs/layout.md.
 *
 * SectionMarker is here for the same reason. There is exactly one square on the
 * page and it walks every section's perimeter in turn, so it belongs to the
 * document rather than to any one section — which is also what lets it cross
 * the gaps BETWEEN sections instead of parking in a corner until the next one
 * starts. The sections declare their own geometry with `SectionTrack`.
 *
 * OsProbe is here because it belongs to the document too — it writes one
 * attribute on <html>, which every download button on every route reads. It is
 * also the only thing on the site that must run before the body is parsed, and
 * the head is the only place that can promise that.
 *
 * SiteNav is here for the same class of reason. It used to be markup inside
 * `Hero.astro`, pinned with `sticky` — and sticky pins a child only for as long
 * as its own parent is on screen, so the nav slid away at the hero's bottom
 * edge and the other ten sections had none at all. A nav that belongs to the
 * whole document has to be rendered by the thing that owns the whole document.
 *
 * RenameProbe and RenameNotice are the temporary pair that says the project
 * used to be called Personal Jarvis: the probe in the head, so a visitor who
 * closed the bar never sees it painted again, and the bar itself last in the
 * body, where it is fixed to the bottom edge and displaces nothing. See
 * src/lib/rename.ts for when both go.
 */
import OsProbe from "@/components/OsProbe.astro";
import PageChrome from "@/components/PageChrome.astro";
import RenameNotice from "@/components/RenameNotice.astro";
import RenameProbe from "@/components/RenameProbe.astro";
import SectionMarker from "@/components/SectionMarker.astro";
import SiteNav from "@/components/SiteNav.astro";
import WorldCanvas from "@/components/world/WorldCanvas.astro";
import "@/styles/global.css";

interface Props {
  title: string;
  description: string;
  /**
   * The 3D scene behind this page: "home" for the scrolled journey, or the name
   * of a still (src/world/script.ts). Every route names one. See docs/world.md.
   */
  world?: string;
  /**
   * The rails and the section marker. The front page turns them off: it is not
   * a column of framed sections any more, and a frame around a scene with
   * depth reads as a window pane.
   */
  chrome?: boolean;
}

const { title, description, world = "quiet", chrome = true } = Astro.props;
const canonical = new URL(Astro.url.pathname, Astro.site);
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    {/* The hooded figure. An SVG, so it follows a light or dark tab strip. */}
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <meta property="og:site_name" content="Dodaios" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    <meta property="og:url" content={canonical} />
    <meta name="generator" content={Astro.generator} />
    {/* A page's own head tags, such as a blog post's social image. */}
    <slot name="head" />

    {/*
      LAST IN THE HEAD, AND IT HAS TO BE IN THE HEAD. It names the visitor's
      machine on <html> so the download buttons can say it, and it has to have
      done so before the body is parsed or the first painted frame carries the
      wrong one. See OsProbe.astro for why this is the one blocking script on
      the site.
    */}
    <OsProbe />
    <RenameProbe />
    {/*
      IN THE HEAD, BEFORE THE BODY IS PARSED. `world-on` decides how the
      chapters are laid out (pinned, one screen each), so it has to be there
      for the first paint or the page would rearrange itself under the reader.
      It promises only that the browser can draw the scene; if the scene then
      fails to start, boot.ts takes the class off again. `?world=off` asks for
      the plain page outright (docs/world.md, "Without the scene").
    */}
    <script is:inline>
      if ("WebGL2RenderingContext" in window && !/[?&]world=off/.test(location.search))
        document.documentElement.classList.add("world-on");
    </script>
  </head>
  <body>
    <WorldCanvas scene={world} />
    {chrome && <PageChrome />}
    {chrome && <SectionMarker />}
    <SiteNav />
    <slot />
    <RenameNotice />
  </body>
</html>
