---
/**
 * The front page: one scrolled journey through the 3D world, in chapters.
 * Each chapter is a pinned screen over the scene; what the camera does in it is
 * written in src/world/script.ts. See docs/world.md.
 */
import Base from "@/layouts/Base.astro";
import Legal from "@/sections/Legal.astro";
import AgentsChapter from "@/sections/world/AgentsChapter.astro";
import HeroChapter from "@/sections/world/HeroChapter.astro";
import InstallChapter from "@/sections/world/InstallChapter.astro";
import OpenChapter from "@/sections/world/OpenChapter.astro";
import ReachChapters from "@/sections/world/ReachChapters.astro";
import StarsChapter from "@/sections/world/StarsChapter.astro";
import TalkChapter from "@/sections/world/TalkChapter.astro";
import TryChapter from "@/sections/world/TryChapter.astro";
---

<Base
  title="Dodaios — an open-source agent OS for your desktop"
  description="Dodaios is an open-source agent OS for your desktop: it runs your coding agents, browser and apps by voice or chat, on your own machine."
  world="home"
  chrome={false}
>
  <main>
    <HeroChapter />
    <TryChapter />
    <TalkChapter />
    <AgentsChapter />
    <ReachChapters />
    <StarsChapter />
    <OpenChapter />
    <InstallChapter />
  </main>
  <div class="world-foot">
    <Legal />
  </div>
</Base>
