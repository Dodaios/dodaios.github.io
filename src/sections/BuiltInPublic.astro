---
/**
 * Section — "Built in public": a year of commits, as a skyline.
 *
 * WHAT IT REPLACED. Until 2026-10-19 this anchor held a YouTube gallery of
 * development videos. Those showed the maintainer's face, and the maintainer
 * asked to no longer be visible on the internet, so the gallery, its poster
 * frames and its stat row were removed. The claim the section makes — the
 * work happens in the open — is now shown through the work itself rather than
 * through the person doing it. See docs/section-6-skyline.md.
 *
 * THE PICTURE. Every day of the last year is a box; its height is the number
 * of commits that landed on the public repository's default branch that day.
 * Seen from above it is a heat map, seen from the corner a skyline, and the
 * camera swings between the two (src/components/skyline/). The component was
 * adapted from one the maintainer supplied; it is drawn here in ink and paper
 * only, in the site's own tokens.
 *
 * NOTHING HERE IS INVENTED. The counts are every commit on `main`, counted
 * per day by scripts/fetch-commit-activity.mjs into
 * src/data/commit-activity.json and refreshed by the social-counts workflow;
 * the browser then tops the year up live from GitHub, so the figure is the one
 * the commit history shows today. Only counts are kept: no author, no message.
 * The quiet months at the start of the year are real too — the repository is
 * younger than the year the picture spans. The caption says when the numbers
 * were read, or that they were read live.
 *
 * IT HOLDS THE READER AND THE SCROLL DRIVES IT (maintainer, 2026-10-19). The
 * section is a `[data-track]` with a sticky `[data-viewport]`, the same
 * construction as the globe above — see docs/layout.md § "A section that is
 * one viewport and still scrolls". Across the pinned span the calendar holds,
 * rises into the skyline week by week, and the camera turns once round it;
 * scrolling back runs it backwards. See `SCRUB` in CommitSkyline.tsx. The
 * marker reads the same `[data-scroll-span]`, so the two agree on how far
 * through the reader is. Narrow, short and reduced-motion windows drop the pin
 * and the skyline rises once when it comes into view instead.
 *
 * Widths come from the one Container; no max-width is named here.
 * See docs/layout.md and docs/design.md.
 */
import Container from "@/components/Container.astro";
import SectionTrack from "@/components/SectionTrack.astro";
import CommitSkyline from "@/components/skyline/CommitSkyline";
import activity from "@/data/commit-activity.json";
import { REPO } from "@/lib/install";

---

<section id="built-in-public" aria-labelledby="bip-heading" class="relative">
  <div data-track data-scroll-span>
  <div data-viewport class="section-full-height flex flex-col">
  <Container width="content" class="section-inset flex min-h-0 flex-1 flex-col">
    <div class="section-bounds section-bounds--fill bip-body flex flex-col justify-center">
      <SectionTrack nested />

      <div class="bip-head">
        <div>
          <p class="bip-eyebrow">Built in public</p>
          <h2 id="bip-heading" class="bip-headline">
            <span class="bip-headline__claim">Built in the open, every day.</span>
            <span class="bip-headline__invite">Each block is a day of work.</span>
          </h2>
        </div>
        <div>
          <p class="bip-standfirst">
            Every commit to the public repository over the last year, counted
            live. The taller the block, the more landed that day. Keep
            scrolling and the calendar rises into a skyline; hover a day for
            its count.
          </p>
          <a
            class="bip-link"
            href={`${REPO}/commits/main`}
            target="_blank"
            rel="noopener"
          >
            Read the commit history
          </a>
        </div>
      </div>

      {/* `client:load`, not `client:visible`: pinned, the chart has to be
          standing in the right pose before the section scrolls into view. */}
      <div class="bip-stage">
        <CommitSkyline
          client:load
          data={activity.days}
          repo={activity.repo}
          readAt={activity.readAt}
        />
      </div>
    </div>
  </Container>
  </div>
  </div>
</section>

<style>
  /* The head and the stage stand off the rails by the inset the Agents
     section uses, so the two share one left edge. */
  .bip-head,
  .bip-stage {
    padding-inline: clamp(0rem, 2.2vw, 2.5rem);
  }

  /* Headline left, standfirst right, on one row — the split the Agents
     section uses, because what sits below is one object as wide as the
     column. Sized from the tokens rather than Tailwind's rem utilities, for
     the reason OpenSource.astro gives. */
  .bip-head {
    display: grid;
    gap: var(--space-base);
    align-items: end;
  }

  @media (min-width: 1024px) {
    .bip-head {
      grid-template-columns: 7fr 5fr;
      gap: var(--space-xl);
    }
  }

  .bip-eyebrow {
    color: var(--muted);
    font-size: var(--text-caption-upper);
    font-weight: 600;
    letter-spacing: var(--tracking-caption-upper);
    text-transform: uppercase;
  }

  .bip-headline {
    margin-top: var(--space-sm);
    font-size: var(--text-display-lg);
    letter-spacing: var(--tracking-display-lg);
    line-height: 1.2;
  }

  .bip-headline__claim,
  .bip-headline__invite {
    display: block;
    text-wrap: balance;
  }

  .bip-headline__claim {
    color: var(--ink);
  }

  .bip-headline__invite {
    color: var(--body);
  }

  .bip-standfirst {
    color: var(--body);
    font-size: var(--text-body);
    line-height: 1.6;
  }

  .bip-link {
    display: inline-block;
    margin-top: var(--space-sm);
    color: var(--ink);
    font-size: var(--text-body-sm);
    text-decoration: underline;
    text-underline-offset: 3px;
    text-decoration-color: var(--hairline-strong);
    transition: text-decoration-color 150ms ease;
  }

  .bip-link:hover {
    text-decoration-color: var(--ink);
  }

  .bip-link:focus-visible {
    outline: 2px solid var(--ink);
    outline-offset: 2px;
  }

  .bip-stage {
    margin-top: var(--space-xl);
  }

  /* The pause. 1.6 screens of pinned scroll: long enough for the rise and
     the turn to be read, short enough that the page does not feel stuck. */
  [data-track] {
    --track: 260svh;

    height: var(--track);
  }

  /* Pinned under the fixed nav, one section tall — layout.css § "Section
     heights", the same rule the globe's viewport follows. */
  [data-viewport] {
    position: sticky;
    top: var(--nav-height);
    height: var(--section-height);
  }

  .bip-body {
    padding-block: clamp(1.25rem, 3svh, 3rem);
  }

  /* While pinned, the chart takes the height the head leaves, so the section
     is exactly one screen whatever the window. */
  @media (min-width: 1024px) and (min-height: 752px) and (prefers-reduced-motion: no-preference) {
    .bip-stage {
      display: flex;
      flex: 1 1 0%;
      flex-direction: column;
      min-height: 0;
    }
  }

  /* Where the pin is dropped: the globe's guards, for the globe's reasons
     (Stargazers.astro § "WHERE THE PIN IS DROPPED"). The section is then an
     ordinary full-height block and the skyline rises once on sight. */
  @media (max-width: 1023px), (max-height: 751px), (prefers-reduced-motion: reduce) {
    [data-track] {
      height: auto;
    }

    [data-viewport] {
      position: static;
      height: auto;
    }
  }
</style>
