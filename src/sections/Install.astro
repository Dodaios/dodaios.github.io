---
/**
 * Section 5 — the four steps, and the closing CTA.
 *
 * Two blocks in one file because together they are the end of the page: the
 * steps show that getting in is small and reversible, and the band under them
 * closes it. See docs/section-5-steps-cta.md.
 *
 * THE FOCUS BEHAVIOUR IS THE SIGNATURE. Exactly one step stands at full
 * opacity; the other three sit at .35.
 *
 * THE SECTION HOLDS THE PAGE STILL WHILE IT HAPPENS. A tall track with a
 * sticky child: the frame stops under the reader, each step owns a quarter of
 * the scrolling, and the section lets go once the fourth has had its share
 * (maintainer, 2026-08-29). This file forbade exactly that until then, and the
 * reason it did — sticky variants break on a phone and feel sluggish — is
 * still true, which is why the pin is off below 1280px, below 1136px of window
 * height, and under `prefers-reduced-motion` — and why a script measures the
 * screen on top of that and drops the pin wherever the four steps and the band
 * do not actually fit.
 *
 * The dimming is opt-in, applied by the script through `data-focus` on the
 * list. Without JavaScript, and under `prefers-reduced-motion`, the attribute
 * is never set: every step reads at full opacity, and the section is an
 * ordinary block. That is the accessible resting state, not a degraded one.
 *
 * STEP 1 CARRIES THE INSTALL BOX, AND IT NEVER LEAVES. What used to sit there
 * was a button that was pulled out of the DOM whenever another step took
 * focus. That was affordable for a 44px button; the box that replaced it
 * (maintainer, 2026-08-29 — print the real command, let the visitor pick their
 * machine) is twice that tall, and adding and removing it on every scroll
 * shunted the three steps below it up and down the screen. It dims with the
 * rest of step 1 instead, and hovering step 1 brings it back to full strength
 * — which is also what makes it clickable without scrolling it into focus
 * first.
 *
 * NOTHING HERE IS INVENTED. Every step is provable from README.md ("Install",
 * "Run it") or from dodaios.toml.example; see the comment on each one.
 *
 * Type sizes live in the style block, not in `text-[…]` utilities. A Tailwind
 * arbitrary value holding a bare custom property is ambiguous and resolves as
 * a COLOUR, which silently leaves every heading at body size.
 */
import Container from "@/components/Container.astro";
import InstallCommand from "@/components/InstallCommand.astro";
import SectionTrack from "@/components/SectionTrack.astro";
import { TurningMark } from "@/components/mark/TurningMark";
import { REPO } from "@/lib/install";

const steps = [
  {
    title: "One command",
    // README § Install: "One command on Windows, macOS, or Linux. You need
    // Python 3.11 or newer and Git; the installer checks for both and stops
    // with a download link if one is missing." Plus the note under the
    // one-liners: it creates a venv, prefetches the voice models, launches.
    body: "Windows, macOS or Linux, one line. You need Python 3.11 or newer and Git; the installer checks for both and stops with a download link if either is missing. It asks nothing else, builds its own environment, fetches the voice models and opens the app.",
    cta: true,
  },
  {
    title: "Pick a wake word",
    // README § Install: "the app walks you through a one-time setup for
    // language, wake word, and API keys". dodaios.toml.example
    // [trigger.wake_word]: "no wake word ships with the product";
    // [persona]: the name is derived from the phrase you choose.
    body: "The app walks you through language, wake word and keys once. Nothing is preset — you type any phrase you like, and the assistant takes its name from it.",
    cta: false,
  },
  {
    title: "Add a key, or skip it",
    // README § Install, optional table: a provider API key or subscription
    // login (Gemini, Claude, OpenAI, OpenRouter), stored in the credential
    // manager. README § "Runs on your own hardware": every layer has a local
    // option needing no API key and no signup.
    body: "In the same setup you hand over a provider key or a subscription login — Gemini, Claude, OpenAI or OpenRouter. It goes into your operating system's credential manager, never into a file. Every tier also has a local option that needs no key at all, so this step is skippable.",
    cta: false,
  },
  {
    title: "Say it",
    // README § Run it: `dodaios` is the full desktop with voice and the Orb
    // overlay; `dodaios serve` is the headless server whose full experience,
    // microphone included, lives in the browser.
    body: "`dodaios` opens the desktop window with voice and the Orb overlay. On a server, `dodaios serve` runs the same assistant in a browser tab, microphone and all.",
    cta: false,
  },
];

/** Backticks in a body become real code spans; the copy is authored here. */
function segments(body: string) {
  return body
    .split(/`([^`]+)`/)
    .map((text, i) => ({ text, code: i % 2 === 1 }));
}
---

<section id="install" class="relative">
  {/*
    NO OPENING `.section-rule`. It used to sit here and it was the worst joint
    on the page: the rule at the section's top edge, the pinned frame's own top
    line 33px below it, and the closing line of the section above 80px above
    that — three horizontal lines in one view, which is the screenshot the
    maintainer sent on 2026-08-29.

    This section is bounded by the pinned frame's two rules, like every other
    section is bounded by its band's two rules. `[data-viewport]` holds them
    `--section-inset` inside the section's edges; `[data-frame]` draws them.
    See docs/layout.md § "One boundary, one shape".
  */}

  {/*
    THE SCROLL TRACK. The section stops under the reader and the four steps
    take their turn one at a time, which is what the maintainer asked for
    (2026-08-29) and what the file used to forbid in as many words.

    Same construction as VoiceSwitch, deliberately: the track's only job is to
    be tall, the sticky child inside it is the single screen anyone sees, and
    `track - viewport` of scrolling is the running length the steps are spread
    over. See docs/layout.md, "A section that is one viewport and still
    scrolls".

    Below the breakpoints in the styles the track collapses to `auto`, the
    child goes static and this is an ordinary block with four steps in it. A
    scroll trap is only worth it where the whole frame actually fits on the
    screen.
  */}
  <div data-track data-scroll-span>
    <div data-viewport>
      <Container width="content" class="flex h-full min-h-0 flex-col">
        {/*
          The pinned frame — the section as the reader sees it, a box closed on
          all four sides: the rails give the two verticals, these two rules the
          horizontals. The section marker walks that perimeter, so it lives in
          HERE and not on the section: the section element is several screens
          tall and a marker halfway down it would be a screen below the fold.
        */}
        <div data-frame>
          <SectionTrack nested />
          <p class="eyebrow uppercase text-muted">Getting started</p>
          <h2 class="headline mt-4 text-balance">How to install Dodaios</h2>

          <div class="steps-row grid gap-12 lg:grid-cols-12">
            <ol class="relative lg:col-span-7" data-steps>
              {
                steps.map((step, i) => (
                  <li class="step relative" data-step>
                    {/*
                      The connecting hairline, drawn as one segment PER GAP rather
                      than as a single line down the list. A single line is spanned
                      against the <ol>, whose box ends at the bottom of the last
                      step's body — several lines below the last badge — so it ran
                      on past the final number into empty space. A segment knows
                      where it has to stop: it starts at its own badge's bottom
                      edge and reaches exactly one step gap down — its `bottom`
                      is the negative of the same `--pin-air` the gap is, so it
                      follows the gap as the gap gives way on a short window —
                      to the top of the next badge. The last step has no gap
                      under it and therefore draws nothing.

                      Its own left offset is not written here. Everything that
                      has to line up with the badge column — this segment, the
                      badge, the text indent — is derived from the same three
                      numbers in the style block below.
                    */}
                    {i < steps.length - 1 && (
                      <span aria-hidden="true" class="step-line absolute w-px bg-hairline" />
                    )}

                    <span class="badge absolute top-0 grid place-items-center rounded-[var(--radius-xs)] border border-hairline bg-canvas font-mono text-muted">
                      {i + 1}
                    </span>

                    <h3 class="step-title font-medium text-ink">{step.title}</h3>

                    <p class="step-body mt-2 text-body">
                      {segments(step.body).map((part) =>
                        part.code ? <code>{part.text}</code> : <Fragment>{part.text}</Fragment>,
                      )}
                    </p>

                    {step.cta && (
                      <div class="mt-4">
                        <InstallCommand />
                      </div>
                    )}
                  </li>
                ))
              }
            </ol>

            {/*
              SEVEN COLUMNS OF TEXT AND FIVE OF MARK, not six and six, and the
              reason is the height of the screen rather than the look of the
              row. At six columns the four bodies wrap to 4/3/4/3 lines; the
              extra column takes two of those away and the list comes out 46px
              shorter, which is 46px the pinned screen no longer has to find.
              The mark does not lose anything for it: it draws as large as its
              box allows and was never as wide as its half of the row.

              Decorative, and gone below 1024px rather than shrunk. `client:media`
              means the WebGL bundle is never even fetched on a phone.

              The frame is a GRID, not a block. Astro wraps a client component in
              `<astro-island>`, a custom element that defaults to `display: inline`
              — a percentage height inside one resolves to nothing and the mark
              renders a few pixels wide. A grid item is blockified whatever its own
              display says, which makes the island fill the frame.
            */}
            <div class="mark-frame hidden lg:col-span-5 lg:grid">
              <TurningMark client:media="(min-width: 1024px)" />
            </div>
          </div>
        </div>

        {/*
          THE CLOSING BAND IS PART OF THE PINNED SCREEN. It sat after the track
          and only arrived once the pin let go, which meant the screen the
          reader was held on never showed the end of the page (maintainer,
          2026-08-29: "the box belongs in that viewport too").

          It hangs straight off the frame's bottom rule — no gap, the same join
          as before — and it needs no Container of its own: it is already on the
          content column, inside the one the sticky child carries. Nesting a
          second `content` Container here would apply the gutter and the
          max-width twice and pull the band 32px inside the rails.

          Sharp corners, flat ink, no gradient. It breaks with everything above
          it on purpose. On this palette the accent IS the ink — docs/design.md
          keeps one action colour and no borrowed hue — so the band is paper and
          its type is the page floor, 18.5:1, well past AA.
        */}
        <div
          class="cta flex shrink-0 flex-col justify-between gap-6 rounded-none bg-ink px-8 text-on-ink md:min-h-[200px] md:flex-row md:items-center"
        >
          <div>
            <h2 class="headline text-balance leading-tight">
              Talk to your computer.<br />It does the thing.
            </h2>
            <p class="cta-sub mt-4 opacity-70">
              Apache 2.0, running on your own machine. Bring the AI subscription
              you already pay for, or an API key, or nothing at all and keep it
              offline.
            </p>
          </div>

          <a
            href={`${REPO}#install`}
            class="action inline-flex h-11 shrink-0 items-center justify-center rounded-[var(--radius-md)] bg-on-ink px-6 font-medium text-ink transition-opacity hover:opacity-85 focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-on-ink"
          >
            Install Dodaios
          </a>
        </div>
      </Container>
    </div>
  </div>
</section>

<style>
  /* --- The track and its one visible screen -------------------------------
   *
   * `--track` is the running length. The reader scrolls (track - viewport) of
   * distance, and the four steps are spread over it: a quarter each, so every
   * step gets its own stretch of scrolling and the section only lets go once
   * the fourth has had it. Four and a half screens is what makes a step feel
   * like a beat rather than a flicker, without the page seeming to have
   * stopped working.
   */
  [data-track] {
    --track: 400svh;

    /* THE AIR IN THIS SCREEN IS MEASURED AGAINST THE WINDOW'S HEIGHT, and it
     * is the only place on the site where a gap is. Everywhere else air is a
     * `--space-*` token in rem, which grows with the ROOT scale — and the root
     * scale grows with the viewport's WIDTH. That is right for a page that
     * scrolls: a wide screen gets a bigger page. It is wrong for the one
     * screen that has to hold four steps, an install box and a band at once,
     * because a 2560px-wide window is 19% taller in content than a 1280px one
     * while being no taller in pixels. It is why this section needed 1213px of
     * window at 2560 and 994px at 1280 for the same four steps.
     *
     * `2rem` is the ceiling, which is `mb-8` — what the steps, the row above
     * them and the band's block padding all used to be written as, and what
     * they still come out at on a tall window. Below that the three of them
     * give way together, down to a 1rem floor. At 2560x1305 that is 22px
     * rather than 38 and hands back 94px of screen: 47 across the three step
     * gaps, 16 above the row, 31 inside the band.
     *
     * ONE NUMBER FOR ALL THREE, because they fail together — a screen that is
     * 40px short is not short in one place. Spend it through this variable,
     * never as a `space-*` utility, or the next window height that does not
     * fit is back to being a hand-measured threshold. */
    --pin-air: clamp(1rem, 1.7svh, 2rem);

    height: var(--track);
  }

  [data-viewport] {
    position: sticky;
    /* Under the nav — the same clearance every pinned section takes, so this
     * section's opening rule lands where an ordinary section's band does.
     *
     * ONE NAV OFF THE HEIGHT, NOT TWO, and it is the same asymmetry the
     * padding below states. `--section-height` subtracts the nav twice because
     * a section that fills a screen has a closing RULE at its bottom edge, and
     * that rule needs the same air above the next section's opening one. This
     * screen has no closing rule: what sits at its bottom is the CTA band, the
     * last block on the page, and under it is the footer. There is no joint
     * there to keep clear, so the second subtraction buys nothing — it only
     * takes 76px out of a screen that is already the tightest on the site.
     *
     * That is not a rounding difference. At 2560x1305 the screen needs 1269px
     * and `--section-height` offers 1153, so the guard below measured the
     * overflow and switched the pin off — the maintainer reported the section
     * scrolling straight past on 2026-08-29, hours after the pin was built.
     * This gives 76 of the missing 116 back and `--pin-air` gives the rest. */
    top: var(--nav-height);
    height: calc(100svh - var(--nav-height));
    /* ASYMMETRIC, AND EACH END FOR ITS OWN REASON.
     *
     * The TOP is this section's inset — the air between its own edge and the
     * frame's opening rule — so it is the same `--section-inset` every other
     * section spends, and two sections always meet the same way.
     *
     * It costs the pinned screen 56px over the `--space-lg` it used to be, and
     * that is real: at 2560 wide it is the difference between a screen that
     * fits in a 1249px window and one that does not. It is paid anyway, and
     * the guard below is what makes paying it safe — where the screen no
     * longer fits, the section stops pinning instead of squeezing the frame
     * and pushing its closing rule under the band.
     *
     * The BOTTOM is not a boundary at all. What sits there is the closing CTA
     * band, not a rule, and the section carries on for another three screens
     * of track below it — so the figure is just air under a block, and paying
     * a second `--section-inset` for it would cost the four steps 56px of
     * screen for nothing. This is the one place on the page where the two ends
     * differ, and it differs because only one of them is a section edge.
     *
     * The 24px it does still cost pushes the height at which this section
     * gives up pinning up by the same amount — see the unpin query below. */
    padding-block: var(--section-inset) var(--space-lg);
    overflow: hidden;
  }

  /* --- The pinned frame --------------------------------------------------
   * The section drawn as a box: the rails give the two sides, these two rules
   * close it top and bottom, and the section marker walks that perimeter.
   * `--rule`, not `--hairline` — this is the page's structure, the same line
   * the rails and every `.section-rule` draw.
   *
   * Inset from the sticky viewport rather than flush with it: a closing line
   * lying exactly on the bottom edge of the window is a line nobody sees.
   *
   * `min-height: 0` carries the flex chain on from the container. One missing
   * link and the content leaves the bottom of the frame instead of the frame
   * getting shorter — docs/layout.md says so, and it is the first thing to
   * check if the steps ever run out through the bottom rule.
   */
  [data-frame] {
    position: relative;
    display: flex;
    flex: 1 1 auto;
    min-height: 0;
    flex-direction: column;
    justify-content: center;
    border-block: 1px solid var(--rule);
    padding-block: var(--space-base);
  }

  .eyebrow {
    font-size: var(--text-caption-upper);
    letter-spacing: var(--tracking-caption-upper);
    font-family: var(--font-mono);
  }

  .headline {
    font-size: var(--text-display-lg);
    letter-spacing: var(--tracking-display-lg);
    line-height: 1.2;
  }

  /*
    THE HEADING BLOCK IS CENTRED ON THE FRAME (maintainer, 2026-08-29). Both
    elements span the full content width, so centring them puts the heading
    over the middle of the WHOLE section — the steps and the artwork together
    — rather than over the steps column it happens to sit above. `text-balance`
    on the h2 does the rest: a centred line that breaks unevenly reads worse
    than a left-aligned one.

    Stated on these two elements through a child combinator, never on
    `[data-frame]` itself. `text-align` inherits, and on the frame it would run
    down into the step list and the closing band as well — both of which are
    left-aligned by design (docs/section-5-steps-cta.md).
  */
  [data-frame] > .eyebrow,
  [data-frame] > .headline {
    text-align: center;
  }

  /*
    THE BADGE COLUMN, and the three numbers the whole of it is built from.
    They live together because they are one measurement split three ways: move
    the inset alone and the text closes up on the numbers; change the badge
    size alone and the connecting line stops running down its middle.

    `--badge-inset` is the one to touch. It holds the numbers clear of the
    frame's own rule, which the section marker draws at exactly the content's
    left edge — so at zero the badges did not sit NEAR that line, they sat ON
    it, and a bordered box touching a border reads as stuck to it (maintainer,
    2026-08-29). Small on purpose: the column should look set in from the rule,
    not indented from it.

    The heading and the eyebrow no longer sit on that rule at all — they are
    centred on the frame, above. Only the badges step in, and the body text
    steps in with them by exactly the same amount, so the gap between a number
    and its title is the one thing that does not change.

    IN REM, NOT IN THE `--space-*` TOKENS, and that is not a slip. The root
    font size on this site grows with the viewport, so the utilities these
    three replace (`w-6`, `pl-10`) grew with it too — a wide screen got a
    bigger page rather than the same page with more air around it. The tokens
    are fixed pixels: stated in those, the badge came out 24px on a 2560px
    screen where it had been 28px, so the numbers would have shrunk on exactly
    the screens the page is scaled up for.
  */
  [data-steps] {
    --badge-size: 1.5rem;
    --badge-inset: 0.75rem;
    --badge-gap: 1rem;
  }

  /* The three places the screen's air is spent. They are here rather than as
     `mt-8`/`mb-8`/`p-8` utilities because a fixed rem does not know how tall
     the window is — see `--pin-air` above. */
  .steps-row {
    margin-top: var(--pin-air);
  }

  .step {
    padding-left: calc(var(--badge-inset) + var(--badge-size) + var(--badge-gap));
  }

  .step:not(:last-child) {
    margin-bottom: var(--pin-air);
  }

  .cta {
    padding-block: var(--pin-air);
  }

  .step-line {
    left: calc(var(--badge-inset) + var(--badge-size) / 2);
    top: var(--badge-size);
    bottom: calc(-1 * var(--pin-air));
  }

  .step-title {
    font-size: var(--text-title-md);
  }

  .step-body {
    font-size: var(--text-body-sm);
  }

  .badge {
    left: var(--badge-inset);
    width: var(--badge-size);
    height: var(--badge-size);
    font-size: var(--text-caption-upper);
  }

  .action {
    font-size: var(--text-body-sm);
  }

  .cta-sub {
    font-size: var(--text-body-sm);
  }

  /* The band's heading has to be stated here, not with a `text-on-ink`
     utility. Tailwind v4 puts utilities in `@layer utilities`, and global.css
     colours h1-h4 from an UNLAYERED rule — unlayered always beats layered,
     whatever the specificity. The utility loses silently and the heading comes
     out paper-on-paper: invisible. */
  .cta .headline {
    color: var(--on-ink);
  }

  /* The dimming only exists once the script has opted in. Without it — no
     JavaScript, or reduced motion — every step reads at full strength. */
  [data-focus] .step {
    opacity: 0.35;
    transition: opacity 300ms ease;
  }

  [data-focus] .step[data-active],
  [data-focus] .step:hover {
    opacity: 1;
  }

  /* The active number is filled, the rest are outlines. */
  [data-focus] .step[data-active] .badge {
    background: var(--surface-strong);
    border-color: var(--surface-strong);
    color: var(--ink);
  }

  /* The frame takes the whole cell — its column's width, its row's height —
     and the mark is drawn as large as that box allows, centred in it.

     It used to be a square with a viewport cap (`aspect-ratio: 1`,
     `max-height: 44svh`), and both were wrong for the same reason: they sized
     the graphic against the SCREEN rather than against the section it lives in
     (maintainer, 2026-08-29). A square in a taller row throws the extra height
     away, and because a grid item with a fixed aspect ratio cannot stretch, the
     square sat at the TOP of the row while the steps ran on past it — the mark
     read as floating in the upper corner with a hole underneath.

     Nothing here needs a cap: the row is only ever as tall as the steps, so
     the mark cannot outgrow the section it is framed against. */
  .mark-frame {
    min-height: 0;
  }

  /* --- Where the pin is off ----------------------------------------------
   * Pinning is only worth it where the whole screen — frame AND band — fits
   * with room to read it. Two cases are structural and one is measured.
   *
   *   narrow    under 1280px the steps column is narrow enough that the four
   *             bodies wrap to five and six lines, and the frame is taller
   *             than any window
   *   calm      prefers-reduced-motion. A section that holds the page still
   *             is exactly what that setting is asking not to happen
   *   short     a floor here, and the real answer in the script
   *
   * THE HEIGHT IS NOT A NUMBER TO TUNE, and this is the third time it has been
   * one. A hand-measured threshold is a copy of a fact about the content — how
   * tall four steps, an install box and a band come out at a given root scale
   * — and every session that touches a step, a padding or the band invalidates
   * it silently. It has already been wrong twice in one afternoon: once when
   * the band moved into this screen, and once when the child's top inset went
   * from 24px to 80px. So the script MEASURES whether the frame can hold its
   * content and sets `data-unpinned` when it cannot, and the rules below carry
   * that attribute as well as the query.
   *
   * The 1136px in the query is a floor for a reader with no JavaScript, not
   * the real threshold: below it the pin cannot be right at any width, and
   * above it the measurement decides. It is the 1060px this was measured at
   * against the pinned BOX, plus the one `--nav-height` the box is shorter
   * than the window it stands in.
   *
   * SPELLED THE SAME IN THE SCRIPT, and for one afternoon it was not: the
   * stylesheet's figure moved with a layout change and the script's stayed,
   * which is the exact mismatch docs/layout.md § "A section that is one
   * viewport and still scrolls" warns about — a scrub driving a section that
   * no longer has a track.
   */
  @media (max-width: 1279px), (max-height: 1135px), (prefers-reduced-motion: reduce) {
    [data-track] {
      height: auto;
    }

    [data-viewport] {
      position: static;
      height: auto;
      padding-block: var(--section-inset) var(--space-lg);
      overflow: visible;
    }

    /* The frame KEEPS its two rules here. Pinned or not, the band hangs off
       the bottom one — take it away and the band floats. */
  }

  /* The measured guard. Same four declarations as the query above, because
     "not pinned" has to look identical however it was arrived at. */
  [data-unpinned] [data-track] {
    height: auto;
  }

  [data-unpinned] [data-viewport] {
    position: static;
    height: auto;
    padding-block: var(--section-inset) var(--space-lg);
    overflow: visible;
  }

  @media (prefers-reduced-motion: reduce) {
    [data-focus] .step {
      transition: none;
    }
  }
</style>

<script>
  /**
   * Which step is active, and where that answer comes from.
   *
   * WHILE THE SECTION IS PINNED NOTHING MOVES, so the rule this used to run on
   * — whichever step's centre is closest to the middle of the window — returns
   * the same step on every frame of the pin. The answer comes from the TRACK
   * instead: how far the reader is through it, split four ways in order, so
   * each step owns a quarter of the scrolling and the section only lets go
   * once the fourth has had its share.
   *
   * `trackProgress` is the same function the section marker and the voice wipe
   * measure with — and it reads the pinned box rather than the window, which
   * is what keeps the fourth step from lighting up before the pin lets go. Three things draw this page's scroll position and one
   * formula decides it, or they drift apart in the way a reader actually
   * notices: the last step lighting up before the marker reaches the corner.
   *
   * WHERE THE PIN IS OFF the old rule is still the right one, because the
   * steps are ordinary blocks moving up the screen again. The media query is
   * the stylesheet's, spelled identically — the CSS decides the geometry and
   * this decides where the value comes from, and a mismatch leaves a scrub
   * driving a section that no longer has a track.
   *
   * AND THIS FILE ALSO DECIDES WHETHER THE PIN IS SAFE AT ALL. The sticky
   * child hides overflow, so a frame shorter than its content loses the bottom
   * of step 4 with nothing on screen to say so. Which window heights are big
   * enough is a fact about the content — four steps, an install box, a band,
   * at a root scale that grows with the viewport — and a hand-measured
   * threshold is a stale copy of it the moment anyone touches a step or a
   * padding. That has already gone wrong twice in an afternoon. So the frame
   * is MEASURED against its own content, and `data-unpinned` goes on the
   * section when it does not fit; the stylesheet carries that attribute
   * alongside its query.
   *
   * Every read is inside a requestAnimationFrame. `getBoundingClientRect`
   * forces layout, and doing that in the scroll handler ties the page's frame
   * rate to the wheel.
   */
  import { trackProgress } from "@/lib/scrollSpan";

  const section = document.querySelector<HTMLElement>("#install");
  const list = section?.querySelector<HTMLElement>("[data-steps]");
  const track = section?.querySelector<HTMLElement>("[data-track]");

  if (section && list && track) {
    const items = Array.from(list.querySelectorAll<HTMLElement>("[data-step]"));
    const reduce = window.matchMedia("(prefers-reduced-motion: reduce)");
    const frameBox = section.querySelector<HTMLElement>("[data-frame]");
    const loose = window.matchMedia(
      "(max-width: 1279px), (max-height: 1135px), (prefers-reduced-motion: reduce)",
    );

    if (!reduce.matches && items.length > 0) {
      list.dataset.focus = "";

      let active = -1;
      let frame = 0;

      const apply = (next: number) => {
        if (next === active) return;
        active = next;

        items.forEach((item, i) => {
          item.toggleAttribute("data-active", i === next);
        });
      };

      /* A quarter of the track each. `Math.min` rather than a clamp because
         the only value that overruns is a progress of exactly 1, at the last
         pixel of the pin, and it belongs to the last step. */
      const fromTrack = () => {
        const progress = trackProgress(track);
        return Math.min(items.length - 1, Math.floor(progress * items.length));
      };

      const fromCentre = () => {
        const middle = window.innerHeight / 2;
        let best = 0;
        let bestDistance = Infinity;

        items.forEach((item, i) => {
          const rect = item.getBoundingClientRect();
          const distance = Math.abs(rect.top + rect.height / 2 - middle);
          if (distance < bestDistance) {
            bestDistance = distance;
            best = i;
          }
        });

        return best;
      };

      /**
       * Does the pinned screen still hold the steps?
       *
       * The test is the failure itself: the last step's list must end above
       * the line that closes the frame. That is what the reader loses when the
       * screen is too short — the sticky child hides overflow, so the bottom
       * of step 4 goes with nothing on screen to say it did.
       *
       * NOT `scrollHeight` against `clientHeight`, which is the obvious test
       * and wrong here twice over. The frame centres its content, so half of
       * any overflow goes off the TOP, and scrollHeight does not count that
       * — a screen 40px short reads as 20px short and slips under any sane
       * tolerance. And the mark's canvas carries an explicit pixel height that
       * is itself derived from the frame, so "the frame's natural height" is
       * circular. The list is neither: it is text, and its height depends on
       * nothing but the column it wraps in.
       *
       * Measured with the attribute OFF, because with it on the section is an
       * ordinary block where everything always fits, and the state would latch
       * for good.
       */
      let deferred = false;

      const checkFit = () => {
        if (!frameBox) return;

        /* NEVER WHILE THE READER IS HERE. Switching modes changes the track
           from four screens to one, which takes ~3,700px out of the document
           in a single frame — the browser clamps the scroll position and the
           reader is thrown to the bottom of the page from wherever they were.
           That is the bug this guard caused on the day it was written: frozen
           at step 2, then suddenly at step 4 with nothing below.

           So a change waits until the section is out of the way, and the
           scroll handler picks the deferred check up when it gets there. A
           mode that is one resize out of date is worth nothing to anybody;
           a page that jumps under a reader's hands costs them their place. */
        const box = section.getBoundingClientRect();
        if (box.bottom > -200 && box.top < window.innerHeight + 200) {
          deferred = true;
          return;
        }
        deferred = false;

        section.removeAttribute("data-unpinned");
        if (loose.matches) return;

        /* Measured with the attribute off, or the section would be an ordinary
           block where everything fits and the state would latch for good. */
        const frameRect = frameBox.getBoundingClientRect();
        const room = parseFloat(getComputedStyle(frameBox).paddingBottom) || 0;
        if (list.getBoundingClientRect().bottom > frameRect.bottom - room + 1) {
          section.setAttribute("data-unpinned", "");
        }
      };

      const unpinned = () => loose.matches || section.hasAttribute("data-unpinned");

      const measure = () => {
        frame = 0;
        if (deferred) checkFit();
        apply(unpinned() ? fromCentre() : fromTrack());
      };

      const schedule = () => {
        if (frame) return;
        frame = requestAnimationFrame(measure);
      };

      const relayout = () => {
        checkFit();
        schedule();
      };

      window.addEventListener("scroll", schedule, { passive: true });
      window.addEventListener("resize", relayout);
      loose.addEventListener("change", relayout);

      /* NOT a ResizeObserver on the frame, tempting as it is. `checkFit`
         changes the frame's height by design — that is how it measures — so an
         observer watching the frame would see its own effect, re-measure, and
         latch into a loop that flips the section between pinned and not on
         every frame. `load` covers the one thing a resize does not: the mark
         and the install box settling after first paint. */
      window.addEventListener("load", relayout);

      relayout();
    }
  }
</script>
