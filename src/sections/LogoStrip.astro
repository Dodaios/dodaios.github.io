---
/**
 * The connection strip — every service Dodaios talks to, in one row.
 *
 * Every mark here is a service the app really connects to (a plugin, a
 * coding-CLI integration or a model/voice provider in the app's catalogs). The
 * caption under the row says the marks only identify those services: no
 * partnership, affiliation or endorsement. Keep it whenever the strip shows
 * third-party marks.
 *
 * Layout follows the bar under the hero in the design reference: equal cells
 * in a single row, 10px apart, no ornament beyond a hairline.
 * See docs/LOGOS.md.
 *
 * There are far more marks than cells, so each cell cycles a stack of them.
 * The card does not move at all: it is a fixed opening, and the marks are
 * drawn down past it from above, one at a time. Nothing rotates, nothing
 * scales, nothing fades — a mark is out of sight because it is outside the
 * opening.
 *
 * That plainness is the point, and it was arrived at rather than assumed. Two
 * mechanisms came before it, and both are worth recording:
 *
 * A **split-flap** cut the card across the middle and dropped the top half
 * forward about the seam. A real board can do that because its seam, frame and
 * shadow explain the cut. The seam was deliberately left out here — it struck
 * a line through every mark on a strip that is mostly still — and without it
 * the moving frames only ever showed a mark sliced in half and offset, which
 * reads as a rendering fault rather than as a card turning over. A halved
 * effect without its mechanism always does.
 *
 * Then the **whole card travelled through depth**, retreating and dissolving
 * while the next arrived. That worked, but it put all eight cards in motion
 * and each arriving one had to paint over its neighbours to do it. This does
 * the same job with the row standing still.
 *
 * The whole thing is CSS — no JavaScript reaches the browser, and
 * `prefers-reduced-motion` gets a still frame instead of a special case.
 *
 * Sizes are rem throughout. The root font size scales with the viewport
 * (src/styles/layout.css), so a px height would freeze while everything around
 * it grew — which is exactly how this strip first read as too small.
 */
import Container from "@/components/Container.astro";
import SectionTrack from "@/components/SectionTrack.astro";
import { marks } from "@/components/logos/marks";

/** Cells in the row at the widest breakpoint, and marks stacked in each. */
const CELLS = 8;
const PER_CELL = 7;

/**
 * One mark's turn: it drops into place from above, holds, then travels on out
 * of the bottom while the next one follows it down. The two move together at
 * the same speed and stay a fixed distance apart, so the column reads as one
 * continuous band being drawn past the opening rather than as two separate
 * marks.
 *
 * The slot and the cycle are unchanged from the effect this replaced, so the
 * strip keeps the same pace — only the movement inside a cell is different.
 */
const CHANGE_S = 0.9;
const HOLD_S = 5.1;
const SLOT_S = CHANGE_S + HOLD_S;
const CYCLE_S = SLOT_S * PER_CELL;

/**
 * Every card's delay is negative, so each animation starts already in
 * progress: at the first paint one mark per cell is resting mid-hold, instead
 * of the strip standing empty until the first change comes round.
 *
 * The offset carries a per-cell term as well as a per-card one. Without it all
 * eight cells change on the same beat, which reads as a mechanism rather than
 * a board; a fraction of a slot apart, the change ripples along the row.
 */
const cellOffset = (c: number) => (c * SLOT_S) / CELLS;
const startAt = (c: number, r: number) => -(r * SLOT_S + cellOffset(c) + SLOT_S / 2);

// The marks list is alphabetical, and the cells run nearly in phase, so a
// straight fill puts neighbouring names (Slack, Spotify, Stripe, Supabase) on
// screen at the same moment and the row looks like it repeats itself. Walking
// the list in strides instead scatters neighbours apart. The stride is coprime
// with the list length, so it visits every mark exactly once, and it is fixed
// rather than random: the same build must produce the same strip.
const STRIDE = 23;
const pool = marks.map((_, i) => marks[(i * STRIDE) % marks.length]);

// Padding, because the grid holds a few more slots than there are marks.
//
// Which mark fills a spare slot matters. Padding from the start of the pool
// puts a copy about one slot away from its original in time, and a card is on
// screen for a whole slot, so both copies end up visible at once — two GitLabs
// side by side. Taking the filler from half a cycle back instead separates the
// pair by three slots, far wider than either is on screen for.
const PAD_BACK = Math.floor(PER_CELL / 2) * CELLS;
while (pool.length < CELLS * PER_CELL) pool.push(pool[pool.length - PAD_BACK]);

const columns = Array.from({ length: CELLS }, (_, c) =>
  Array.from({ length: PER_CELL }, (_, r) => pool[r * CELLS + c]),
);

/** Which cells survive at which width — the row never wraps. */
const visibility = [
  "",
  "",
  "",
  "hidden sm:block",
  "hidden lg:block",
  "hidden lg:block",
  "hidden 2xl:block",
  "hidden 2xl:block",
];
---

<!-- The standard section shell — see docs/layout.md § "One boundary, one
     shape". This strip used to be the one section on `py-20` while its
     neighbours were on `py-24`, which is the kind of drift a shared shell
     exists to stop.

     The cells lift off the page by being `--surface-card` on `--canvas`, and
     that step is the whole reason they read as cells rather than as holes.
     While the page still had per-section tones this strip had to sit on the
     deepest of them for exactly that reason — on the raised tone only 6 of the
     15 points of lift were left and the cells inverted. One ground removes the
     hazard: nothing can eat the card step any more. Do not paint a background
     under this section to bring it back. -->
<section
  aria-labelledby="connects-label"
  class="relative flex flex-col"
>
  <Container width="content" class="section-inset flex min-h-0 flex-1 flex-col">
    <!--
      `strip` redraws the two rails ON TOP of the cells. The real rails sit at
      z-index -1, behind every card; these cells stand on both of them and are
      filled near the page colour, so they hide the line without reading as a
      surface — the fault docs/layout.md names under "Blocks that cross a rail".
      Wrapping `--rule` around the end cards would bend the line around their
      radius, which still reads as an interruption. A 1px overlay keeps it
      straight, so the row does not break the page's frame.
    -->
    <div class="section-bounds strip">
      <SectionTrack nested />
      <p id="connects-label" class="eyebrow">Everything Dodaios connects</p>

      <ul
        class="row mt-8 grid grid-cols-3 sm:grid-cols-4 lg:grid-cols-6 2xl:grid-cols-8"
        style={`--cycle:${CYCLE_S}s`}
      >
        {
          columns.map((stack, c) => (
            <li class={`cell ${visibility[c]}`}>
              {stack.map(({ name, Mark, rem }, r) => (
                <span
                  class="surface"
                  style={`--delay:${startAt(c, r).toFixed(2)}s; --mark:${rem}rem`}
                >
                  <Mark className="mark" />
                  <span class="sr-only">{name}</span>
                </span>
              ))}
            </li>
          ))
        }
      </ul>
      <p class="disclaimer">
        Integrations shown for identification only. No affiliation or
        endorsement implied. All marks belong to their owners.
      </p>
    </div>
  </Container>
</section>

<style>
  /*
   * Same drawing as `.page-chrome__rails`, painted on top of this band's
   * cells. `isolation` keeps the overlay's z-index inside this band, so it
   * cannot climb into the page and land on a neighbour. z-index 1 clears the
   * cards (auto) and stays under the section marker at 20. Hidden below
   * 768px, where the rails themselves are.
   *
   * Isolation used to be forbidden on the section itself — it trapped the
   * retired tone layer above the real rails. It is safe here either way: this
   * is the inner band, and the section around it paints nothing.
   */
  .strip {
    isolation: isolate;
  }

  /*
   * The row stands clear of the two vertical rules rather than against them.
   *
   * Those rules are drawn at the edges of this band, so with the grid running
   * the full width the first and last card touched the line — which reads as a
   * row that has been cut off at both ends rather than one sitting inside a
   * frame. Every other section clears the rules by way of its text measure;
   * this one is the only section whose content is edge-to-edge, so it is the
   * only one that has to say so.
   *
   * The end space is one gap, from the same value, so the row keeps a single
   * rhythm: card, gap, card, gap, card, gap, rule. Two literals here would
   * drift the first time either is tuned. 10px is measured from the reference
   * bar — see docs/LOGOS.md.
   */
  .row {
    --cell-gap: 10px;

    gap: var(--cell-gap);
    padding-inline: var(--cell-gap);
  }

  .strip::after {
    content: "";
    position: absolute;
    inset: 0;
    z-index: 1;
    border-inline: 1px solid var(--rule);
    pointer-events: none;
  }

  @media (max-width: 767px) {
    .strip::after {
      display: none;
    }
  }

  .eyebrow {
    text-align: center;
    font-size: var(--text-caption-upper);
    font-weight: 600;
    letter-spacing: var(--tracking-caption-upper);
    text-transform: uppercase;
    color: var(--muted);
  }

  .disclaimer {
    margin-top: 1rem;
    text-align: center;
    font-size: var(--text-caption-upper);
    color: var(--muted);
  }

  /*
   * THE CARD IS THE CELL, and it never moves. Only the marks travel, and they
   * travel inside it.
   *
   * That is why the border, the ground and the clipping all live here rather
   * than on the moving element: the visitor should see one fixed opening with
   * marks being drawn past it. Put the border on the moving element instead
   * and the card itself appears to slide, which is a different effect and a
   * much busier one — eight cards sliding is the whole row in motion.
   *
   * `overflow: hidden` is load-bearing, not tidiness. The marks queue directly
   * above and below the opening, and without it every cell would show its
   * whole waiting stack.
   */
  .cell {
    position: relative;
    height: 6.5rem;
    overflow: hidden;
    border: 1px solid var(--hairline);
    border-radius: var(--radius-lg);
    background: var(--surface-card);
    color: var(--ink);
  }

  .surface {
    position: absolute;
    inset: 0;
    display: flex;
    align-items: center;
    justify-content: center;
    padding-inline: 1rem;
    animation: surface var(--cycle) linear infinite;
    animation-delay: var(--delay);
  }

  .surface :global(.mark) {
    /*
     * One knob for the whole strip. Each mark carries its own optical height
     * (docs/LOGOS.md); this scales all of them together, so "the marks are too
     * small" is one number here rather than fifty in marks.ts.
     */
    height: calc(var(--mark) * 1.1);
    width: auto;
  }

  /*
   * The change takes 0.9s of a 6s slot. Against the 42s cycle a slot is
   * 14.286% and the change is 2.143%.
   *
   * A mark waits one card-height ABOVE the opening, drops into it, holds, and
   * travels on out of the bottom. The next one is the same animation a slot
   * later, so the two move at the same moment, at the same speed, staying
   * exactly 115% apart the whole way. That is what sells it as one band being
   * drawn past the opening instead of two marks passing each other.
   *
   * Downwards rather than up, which is the maintainer's call and not an
   * arbitrary one: falling is the direction a departure board, a flip clock
   * and a dealt card all move, so it is the reading the eye offers first.
   *
   * Both halves of the movement use the same curve for the same reason: give
   * the departing and arriving marks different easing and the gap between them
   * stretches and squeezes mid-travel, which reads as a slip.
   *
   * The 115% is a deliberate 15% of a card's height of clear space between one
   * mark and the next. At exactly 100% they touch, and two marks meeting at
   * the edge of the opening look like one shape breaking apart.
   *
   * No `opacity` anywhere: a waiting mark is hidden because it is outside the
   * cell, which `overflow: hidden` clips. Fading marks in and out on top of
   * the travel would undo the illusion — a band does not dissolve at the edge
   * of the window it moves through.
   */
  @keyframes surface {
    0% {
      transform: translateY(-115%);
      animation-timing-function: cubic-bezier(0.5, 0, 0.3, 1);
    }
    2.14% {
      transform: translateY(0);
    }
    14.29% {
      transform: translateY(0);
      animation-timing-function: cubic-bezier(0.5, 0, 0.3, 1);
    }
    16.43% {
      transform: translateY(115%);
    }
    100% {
      transform: translateY(115%);
    }
  }

  /*
   * No motion: the board holds the first mark of each cell, at rest.
   */
  @media (prefers-reduced-motion: reduce) {
    .surface {
      animation: none;
      transform: none;
      opacity: 0;
    }
    .surface:first-child {
      opacity: 1;
    }
  }
</style>
