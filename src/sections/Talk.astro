---
/**
 * Feature section — copy left, "Code by talking" demo right.
 *
 * The first block of the feature run under the logo strip, and the same shape
 * as Plugins.astro, which carries the whole reasoning for the run: no band, no
 * ground, `.section-run-rule` on the section so the joint to Plugins is one
 * hairline, and the marker tracked on the section, not `open`, because a rule
 * is drawn under it. See docs/feature-section.md.
 *
 * It leads the run because it is the one sentence people repeat: you talk,
 * and your coding agents do the work in their own panes.
 */
import Container from "@/components/Container.astro";
import SectionTrack from "@/components/SectionTrack.astro";
import { TalkDemo } from "@/components/talk-demo/TalkDemo";

const GUIDE_URL =
  "https://github.com/Dodaios/Dodaios/blob/main/docs/product/extend-and-automate/agentic-ide.md#send-clear-work";
---

<section id="talk" class="section-run-rule relative flex flex-col">
  <SectionTrack />
  <Container width="content" class="section-inset flex min-h-0 flex-1 flex-col">
    <div
      class="grid grid-cols-[minmax(0,1fr)] items-center gap-12 px-8 lg:aspect-[16/9] lg:min-h-[560px] lg:grid-cols-12 lg:grid-rows-[minmax(0,1fr)] lg:p-14"
    >
      <div class="lg:col-span-5">
        <p class="text-[22px] leading-snug sm:text-[26px]">
          <span class="font-medium text-ink">Code by talking.</span>{" "}
          <span class="text-body"
            >Put Claude Code, Codex and OpenCode side by side and tell them what
            to do. Say "T1, run the tests" and Dodaios writes the brief and types
            it into the right pane, on the subscriptions you already pay for.</span
          >
        </p>

        <a
          href={GUIDE_URL}
          class="mt-6 inline-flex items-center gap-2 text-[16px] font-medium text-ink underline-offset-4 hover:underline"
        >
          How talking to your agents works
          <span aria-hidden="true">&#8594;</span>
        </a>
      </div>

      <div class="min-h-0 min-w-0 lg:col-span-7 lg:h-full">
        <TalkDemo client:visible />
      </div>
    </div>
  </Container>
</section>
