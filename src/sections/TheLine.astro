---
/**
 * Section — "You draw the line": what leaves the computer, and who decides.
 *
 * It took the place of the "Built in public" video gallery on 2026-10-19, at
 * the maintainer's request: that section put the maintainer's face on the
 * page, and they did not want to be visible on the internet. See
 * docs/section-the-line.md.
 *
 * THE IDEA. The page is built out of rules — two rails, a line closing every
 * section. This section turns one of them into the subject: a dotted line
 * with "your computer" on one side and "providers you pick" on the other, and
 * the path a spoken request takes drawn across it. Three stages of that path —
 * speech to text, the brain, the voice — can run on either side, and the
 * visitor moves them: with a click on the part, or with the switches under
 * the diagram. Small squares (the page's own marker, in miniature) ride the
 * path; hollow while they are sound, solid while they are words. They
 * brighten when they cross, and the strip under the diagram says in words
 * what is crossing.
 *
 * IT OPENS ON THE SHIPPED DEFAULT, with all three stages outside, because that
 * is what a fresh install does. The section's pleasure is pulling them in; its
 * honesty is starting where the product really starts. See src/lib/theLine.ts
 * for the facts behind every engine name and sentence here.
 *
 * THE DIAGRAM TAKES THE WHOLE COLUMN. Beside a copy column it came out at two
 * thirds of its drawn size and its labels at ten pixels; the head goes above
 * it instead, split the way the Agents section splits its own, and the
 * controls go in one strip below.
 *
 * IT ADDS NO SCROLL BEHAVIOUR, for the reason OpenSource.astro gives: the
 * globe above is a scroll trap, and a second pinned section in a row would
 * make the page impossible to scroll past without stops. The animation runs
 * only while the section is on screen, and not at all under reduced motion.
 *
 * TWO DRAWINGS, ONE STATE. The wide diagram stands the line upright; below
 * 640px a tall one lays it across, because the wide one scaled to a phone
 * leaves its labels a few pixels high. Both are rendered here, CSS shows one,
 * and the script drives whichever is visible from the same three switches.
 *
 * Widths come from the one Container; no max-width is named here.
 * See docs/layout.md and docs/design.md.
 */
import Container from "@/components/Container.astro";
import SectionTrack from "@/components/SectionTrack.astro";
import {
  DEFAULT_SIDE,
  MOVABLE,
  PARTS,
  TALL,
  WIDE,
  pointsToD,
  seatOf,
  wirePoints,
  type Layout,
  type PartId,
} from "@/lib/theLine";

const LAYOUTS: { key: "wide" | "tall"; layout: Layout }[] = [
  { key: "wide", layout: WIDE },
  { key: "tall", layout: TALL },
];

const ORDER: PartId[] = ["mic", "wake", "memory", "speaker", "stt", "brain", "voice"];

const isMovable = (id: PartId) => (MOVABLE as readonly string[]).includes(id);

/** The first paint is the default state, so the page reads right before JS. */
const wireD = (layout: Layout, from: PartId, to: PartId, route: Layout["path"][number]["route"]) =>
  pointsToD(wirePoints(seatOf(layout, from, DEFAULT_SIDE), seatOf(layout, to, DEFAULT_SIDE), route));

const engineOf = (id: PartId) => {
  const part = PARTS[id];
  if (isMovable(id) && DEFAULT_SIDE[id as keyof typeof DEFAULT_SIDE] === "provider") {
    return part.provider ?? part.local;
  }
  return part.local;
};
---

<section
  id="privacy"
  aria-labelledby="line-heading"
  class="section-full-height flex flex-col"
>
  <Container width="content" class="section-inset flex min-h-0 flex-1 flex-col">
    <div
      class="section-bounds section-bounds--fill flex flex-col justify-center"
      data-line-root
    >
      <SectionTrack nested />

      <div class="line-head">
        <div>
          <p class="line-eyebrow">Privacy</p>
          <h2 id="line-heading" class="line-headline">
            <span class="line-headline__claim">You draw the line.</span>
            <span class="line-headline__invite">Dodaios only crosses it where you say.</span>
          </h2>
        </div>
        <p class="line-standfirst">
          Every part can run on your computer or with a provider you pick.
          Move one across the line and watch what goes over. The wake word,
          your memory and your API keys never do.
        </p>
      </div>

      <div class="line-stage">
        {
          LAYOUTS.map(({ key, layout }) => {
            const { w, h } = layout.node;
            const lineIsUpright = layout.line.axis === "x";
            return (
              <svg
                class={`line-svg line-svg--${key}`}
                data-line-svg={key}
                viewBox={`0 0 ${layout.width} ${layout.height}`}
                role="group"
                aria-label="The path of a spoken request, from the microphone to the speaker, and which side of the line each part runs on"
              >
                <text class="line-zone" x={layout.labels.local.x} y={layout.labels.local.y}>
                  Your computer
                </text>
                <text class="line-zone" x={layout.labels.provider.x} y={layout.labels.provider.y}>
                  Providers you pick
                </text>

                {lineIsUpright ? (
                  <line
                    class="line-boundary"
                    x1={layout.line.at}
                    x2={layout.line.at}
                    y1={4}
                    y2={layout.height - 4}
                  />
                ) : (
                  <line
                    class="line-boundary"
                    x1={4}
                    x2={layout.width - 4}
                    y1={layout.line.at}
                    y2={layout.line.at}
                  />
                )}

                <g class="line-wires">
                  {layout.path.map((wire) => (
                    <path
                      class="line-wire"
                      data-wire={`${wire.from}-${wire.to}`}
                      d={wireD(layout, wire.from, wire.to, wire.route)}
                    />
                  ))}
                  <path
                    class="line-wire line-wire--context"
                    data-wire={`${layout.context.from}-${layout.context.to}`}
                    d={wireD(layout, layout.context.from, layout.context.to, layout.context.route)}
                  />
                </g>

                {/* Said where the brain would stand outside, once nothing does. */}
                <text
                  class="line-empty"
                  x={layout.seats.brain.provider.x}
                  y={layout.seats.brain.provider.y + 5}
                  text-anchor="middle"
                >
                  Nothing crosses.
                </text>

                <g data-flashes />
                <g data-packets />

                {ORDER.map((id) => {
                  const at = seatOf(layout, id, DEFAULT_SIDE);
                  const movable = isMovable(id);
                  const outside = movable && DEFAULT_SIDE[id as keyof typeof DEFAULT_SIDE] === "provider";
                  return (
                    <g
                      class:list={["line-part", { "line-part--movable": movable, "is-outside": outside }]}
                      data-part={id}
                      transform={`translate(${at.x} ${at.y})`}
                      {...(movable
                        ? {
                            role: "button",
                            tabindex: "0",
                            "aria-label": `${PARTS[id].label}: runs with a provider. Move it across the line.`,
                          }
                        : {})}
                    >
                      <rect class="line-part__box" x={-w / 2} y={-h / 2} width={w} height={h} rx={8} />
                      <text
                        class="line-part__label"
                        x={layout.engines ? -w / 2 + 16 : 0}
                        y={layout.engines ? -4 : 5}
                        text-anchor={layout.engines ? "start" : "middle"}
                      >
                        {PARTS[id].label}
                      </text>
                      {layout.engines && (
                        <text class="line-part__engine" data-engine x={-w / 2 + 16} y={16}>
                          {engineOf(id)}
                        </text>
                      )}
                      {movable && layout.engines && (
                        <path
                          class="line-part__swap"
                          transform={`translate(${w / 2 - 20} ${-h / 2 + 16})`}
                          d="M-5 0 H5 M-5 0 l3 -3 M-5 0 l3 3 M5 0 l-3 -3 M5 0 l-3 3"
                        />
                      )}
                    </g>
                  );
                })}
              </svg>
            );
          })
        }
      </div>

      {/*
        The strip. One cell per movable stage, in the order a request meets
        them: its name, a two-way switch, and in words what that stage sends
        over the line — or that it sends nothing. Both sentences are in the
        markup and the state shows one, so no element is built in the browser
        and the page reads right before any script runs.
      */}
      <div class="line-strip">
        {
          MOVABLE.map((id) => (
            <div class="line-cell" data-cell={id} data-side={DEFAULT_SIDE[id]}>
              <div class="line-cell__top">
                <span class="line-cell__name">{PARTS[id].label}</span>
                <span class="line-seg" role="group" aria-label={`Where ${PARTS[id].label.toLowerCase()} runs`}>
                  <button
                    type="button"
                    data-move={id}
                    data-side="local"
                    aria-pressed={DEFAULT_SIDE[id] === "local" ? "true" : "false"}
                  >
                    My computer
                  </button>
                  <button
                    type="button"
                    data-move={id}
                    data-side="provider"
                    aria-pressed={DEFAULT_SIDE[id] === "provider" ? "true" : "false"}
                  >
                    Provider
                  </button>
                </span>
              </div>
              <p class="line-cell__text line-cell__text--provider" aria-live="polite">
                <span class="line-cell__verdict">Crosses:</span> {PARTS[id].leaves}
              </p>
              <p class="line-cell__text line-cell__text--local" aria-live="polite">
                <span class="line-cell__verdict">Stays.</span> {PARTS[id].stays}
              </p>
            </div>
          ))
        }
      </div>

      <div class="line-foot">
        <p class="line-default">
          Out of the box all three use a provider, because that runs on any machine.
        </p>
        <button type="button" class="line-pull" data-pull>Pull everything inside</button>
      </div>
    </div>
  </Container>
</section>

<style>
  /* --- The head ----------------------------------------------------------
   * Headline left, standfirst right, on one baseline row — the split the
   * Agents section uses, because what sits below is one object as wide as the
   * column. Sized from the tokens, not Tailwind's rem utilities, for the
   * reason OpenSource.astro gives.
   */
  /* Everything stands off the rails by the inset the Agents section uses, so
     the two sections share one left edge. */
  .line-head,
  .line-stage,
  .line-strip,
  .line-foot {
    padding-inline: clamp(0rem, 2.2vw, 2.5rem);
  }

  .line-head {
    display: grid;
    gap: var(--space-base);
    align-items: end;
  }

  @media (min-width: 1024px) {
    .line-head {
      grid-template-columns: 7fr 5fr;
      gap: var(--space-xl);
    }
  }

  .line-eyebrow {
    color: var(--muted);
    font-size: var(--text-caption-upper);
    font-weight: 600;
    letter-spacing: var(--tracking-caption-upper);
    text-transform: uppercase;
  }

  .line-headline {
    margin-top: var(--space-sm);
    font-size: var(--text-display-lg);
    letter-spacing: var(--tracking-display-lg);
    line-height: 1.2;
  }

  .line-headline__claim,
  .line-headline__invite {
    display: block;
    text-wrap: balance;
  }

  .line-headline__claim {
    color: var(--ink);
  }

  .line-headline__invite {
    color: var(--body);
  }

  .line-standfirst {
    color: var(--body);
    font-size: var(--text-body);
    line-height: 1.6;
  }

  /* --- The diagram -------------------------------------------------------
   * Hairlines and type only, as everywhere else. The line itself is dotted in
   * `--rule`, the colour of the page's own boundaries, because it IS one: the
   * boundary of the machine.
   */
  .line-stage {
    margin-top: var(--space-xl);
  }

  .line-svg {
    display: block;
    width: 100%;
    height: auto;
    overflow: visible;
    font-family: var(--font-sans);
  }

  .line-svg--tall {
    display: none;
  }

  @media (max-width: 639px) {
    .line-svg--wide {
      display: none;
    }

    .line-svg--tall {
      display: block;
    }
  }

  .line-empty {
    fill: var(--muted);
    font-size: 15px;
    opacity: 0;
    transition: opacity 400ms ease;
  }

  [data-all-local="true"] .line-empty {
    opacity: 1;
    transition-delay: 450ms;
  }

  .line-zone {
    fill: var(--muted);
    font-size: 11px;
    font-weight: 600;
    letter-spacing: 0.88px;
    text-transform: uppercase;
  }

  .line-boundary {
    stroke: var(--rule);
    stroke-width: 2.5;
    stroke-linecap: round;
    stroke-dasharray: 0 9;
  }

  .line-wire {
    fill: none;
    stroke: var(--hairline-strong);
    stroke-width: 1.25;
  }

  .line-wire--context {
    stroke-dasharray: 3 5;
  }

  .line-part__box {
    fill: var(--surface-card);
    stroke: var(--hairline-strong);
    stroke-width: 1;
    transition: stroke 150ms ease;
  }

  .line-part.is-outside .line-part__box {
    stroke-dasharray: 4 3;
  }

  .line-part__label {
    fill: var(--ink);
    font-size: 16px;
    font-weight: 500;
  }

  .line-svg--tall .line-part__label {
    font-size: 13.5px;
  }

  .line-part__engine {
    fill: var(--muted);
    font-family: var(--font-mono);
    font-size: 11px;
  }

  .line-part__swap {
    fill: none;
    stroke: var(--muted);
    stroke-width: 1.25;
    stroke-linecap: round;
    transition: stroke 150ms ease;
  }

  .line-part--movable {
    cursor: pointer;
    outline: none;
  }

  .line-part--movable:hover .line-part__box,
  .line-part--movable:focus-visible .line-part__box {
    stroke: var(--ink);
  }

  .line-part--movable:focus-visible .line-part__box {
    stroke-width: 2;
  }

  .line-part--movable:hover .line-part__swap,
  .line-part--movable:focus-visible .line-part__swap {
    stroke: var(--ink);
  }

  /* Packets and flashes are created by the script, so they carry no scope
     attribute; their colours still live here so the script names no hex. */
  .line-svg :global(.line-packet) {
    fill: var(--muted);
    stroke: var(--muted);
    stroke-width: 1.25;
  }

  .line-svg :global(.line-packet--sound) {
    fill: var(--canvas);
  }

  .line-svg :global(.line-packet.is-outside) {
    fill: var(--ink);
    stroke: var(--ink);
  }

  .line-svg :global(.line-packet--sound.is-outside) {
    fill: var(--canvas);
  }

  .line-svg :global(.line-flash) {
    fill: none;
    stroke: var(--ink);
    stroke-width: 1.5;
  }

  /* --- The strip ---------------------------------------------------------
   * Three cells, one per movable stage. Cards, because they are objects the
   * visitor acts on, not the page's structure: `--hairline`, never `--rule`.
   */
  .line-strip {
    display: grid;
    gap: var(--space-sm);
    margin-top: var(--space-xl);
  }

  @media (min-width: 768px) {
    .line-strip {
      grid-template-columns: repeat(3, minmax(0, 1fr));
    }
  }

  .line-cell {
    padding: var(--space-base);
    border: 1px solid var(--hairline);
    border-radius: var(--radius-lg);
    background: var(--surface-card);
  }

  .line-cell__top {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: var(--space-xs);
  }

  .line-cell__name {
    color: var(--ink);
    font-size: var(--text-body-sm);
    font-weight: 500;
  }

  .line-seg {
    display: inline-flex;
    padding: 3px;
    border: 1px solid var(--hairline-strong);
    border-radius: var(--radius-pill);
    background: var(--canvas);
  }

  /* The pressed half is paper on ink — the one action colour this system
     has — so the state reads from across the room without a second hue. */
  .line-seg button {
    min-height: 30px;
    padding-inline: var(--space-sm);
    border-radius: var(--radius-pill);
    color: var(--muted);
    font-size: var(--text-caption);
    font-weight: 500;
    transition:
      background-color 150ms ease,
      color 150ms ease;
  }

  .line-seg button:hover {
    color: var(--ink);
  }

  .line-seg button[aria-pressed="true"] {
    background: var(--ink);
    color: var(--on-ink);
  }

  .line-seg button:focus-visible,
  .line-pull:focus-visible {
    outline: 2px solid var(--ink);
    outline-offset: 2px;
  }

  .line-cell__text {
    margin-top: var(--space-sm);
    color: var(--body);
    font-size: var(--text-body-sm);
    line-height: 1.5;
  }

  .line-cell__verdict {
    color: var(--ink);
    font-weight: 500;
  }

  .line-cell[data-side="local"] .line-cell__text--provider,
  .line-cell[data-side="provider"] .line-cell__text--local {
    display: none;
  }

  /* --- The foot ----------------------------------------------------------
   * The honest default on the left, the one shortcut on the right.
   */
  .line-foot {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: var(--space-sm);
    margin-top: var(--space-base);
  }

  .line-default {
    color: var(--muted);
    font-size: var(--text-caption);
  }

  .line-pull {
    color: var(--ink);
    font-size: var(--text-body-sm);
    text-decoration: underline;
    text-underline-offset: 3px;
    text-decoration-color: var(--hairline-strong);
    transition: text-decoration-color 150ms ease;
  }

  .line-pull:hover {
    text-decoration-color: var(--ink);
  }
</style>

<script>
  import {
    DEFAULT_SIDE,
    MOVABLE,
    PARTS,
    TALL,
    WIDE,
    pointsToD,
    seatOf,
    wirePoints,
    type Layout,
    type MovableId,
    type PartId,
    type Point,
    type Side,
  } from "@/lib/theLine";

  const SVG_NS = "http://www.w3.org/2000/svg";
  const MOVE_MS = 650;
  /** Viewbox units per second. Slow enough to follow one square by eye. */
  const SPEED = 170;
  const SPAWN_MS = 1100;
  const CONTEXT_MS = 3400;
  const FLASH_MS = 700;

  const root = document.querySelector<HTMLElement>("[data-line-root]");
  if (root) init(root);

  function init(root: HTMLElement) {
    const reduced = window.matchMedia("(prefers-reduced-motion: reduce)").matches;
    const sides: Record<MovableId, Side> = { ...DEFAULT_SIDE };

    /** Where each movable part is drawn right now, per drawing, mid-move included. */
    type Drawing = {
      layout: Layout;
      svg: SVGSVGElement;
      pos: Record<PartId, Point>;
      packets: SVGGElement;
      flashes: SVGGElement;
    };

    const drawings: Drawing[] = [];
    for (const svg of root.querySelectorAll<SVGSVGElement>("[data-line-svg]")) {
      const layout = svg.dataset.lineSvg === "tall" ? TALL : WIDE;
      const pos = {} as Record<PartId, Point>;
      for (const id of Object.keys(PARTS) as PartId[]) pos[id] = seatOf(layout, id, sides);
      drawings.push({
        layout,
        svg,
        pos,
        packets: svg.querySelector<SVGGElement>("[data-packets]")!,
        flashes: svg.querySelector<SVGGElement>("[data-flashes]")!,
      });
    }

    const visible = () => drawings.find((d) => d.svg.getClientRects().length > 0);

    /* --- Drawing the state ---------------------------------------------- */

    function placeParts(d: Drawing) {
      for (const id of Object.keys(PARTS) as PartId[]) {
        const g = d.svg.querySelector<SVGGElement>(`[data-part="${id}"]`);
        if (g) g.setAttribute("transform", `translate(${d.pos[id].x} ${d.pos[id].y})`);
      }
      for (const wire of [...d.layout.path, d.layout.context]) {
        const el = d.svg.querySelector(`[data-wire="${wire.from}-${wire.to}"]`);
        el?.setAttribute("d", pointsToD(wirePoints(d.pos[wire.from], d.pos[wire.to], wire.route)));
      }
    }

    function labelParts() {
      for (const id of MOVABLE) {
        const part = PARTS[id];
        for (const d of drawings) {
          const g = d.svg.querySelector<SVGGElement>(`[data-part="${id}"]`);
          if (!g) continue;
          g.classList.toggle("is-outside", sides[id] === "provider");
          const engine = g.querySelector("[data-engine]");
          if (engine) engine.textContent = sides[id] === "provider" ? part.provider ?? part.local : part.local;
          g.setAttribute(
            "aria-label",
            `${part.label}: ${sides[id] === "provider" ? "runs with a provider" : "runs on your computer"}. Move it across the line.`,
          );
        }
        for (const button of root.querySelectorAll<HTMLButtonElement>(`[data-move="${id}"]`)) {
          button.setAttribute("aria-pressed", String(button.dataset.side === sides[id]));
        }
      }

      for (const id of MOVABLE) {
        const cell = root.querySelector<HTMLElement>(`[data-cell="${id}"]`);
        if (cell) cell.dataset.side = sides[id];
      }

      const leaving = MOVABLE.filter((id) => sides[id] === "provider");
      root.dataset.allLocal = String(leaving.length === 0);

      const pull = root.querySelector<HTMLButtonElement>("[data-pull]")!;
      pull.textContent = leaving.length === 0 ? "Back to the default" : "Pull everything inside";
    }

    /* --- Moving a part --------------------------------------------------- */

    const tweens = new Map<string, { from: Point; to: Point; start: number }>();

    function setSides(next: Partial<Record<MovableId, Side>>) {
      const now = performance.now();
      for (const id of MOVABLE) {
        const side = next[id];
        if (!side || side === sides[id]) continue;
        sides[id] = side;
        for (const d of drawings) {
          const to = seatOf(d.layout, id, sides);
          if (reduced) {
            d.pos[id] = to;
          } else {
            tweens.set(`${d.layout === TALL ? "tall" : "wide"}:${id}`, { from: { ...d.pos[id] }, to, start: now });
          }
        }
      }
      labelParts();
      for (const d of drawings) placeParts(d);
      wake();
    }

    const ease = (t: number) => (t < 0.5 ? 4 * t * t * t : 1 - Math.pow(-2 * t + 2, 3) / 2);

    function stepTweens(now: number) {
      for (const [key, tween] of tweens) {
        const [which, id] = key.split(":") as ["wide" | "tall", MovableId];
        const d = drawings.find((x) => (x.layout === TALL ? "tall" : "wide") === which);
        if (!d) continue;
        const t = Math.min(1, (now - tween.start) / MOVE_MS);
        const k = ease(t);
        d.pos[id] = {
          x: tween.from.x + (tween.to.x - tween.from.x) * k,
          y: tween.from.y + (tween.to.y - tween.from.y) * k,
        };
        if (t >= 1) tweens.delete(key);
      }
    }

    root.addEventListener("click", (event) => {
      const target = event.target as Element;
      const button = target.closest<HTMLButtonElement>("[data-move]");
      if (button) {
        setSides({ [button.dataset.move as MovableId]: button.dataset.side as Side });
        return;
      }
      if (target.closest("[data-pull]")) {
        const allInside = MOVABLE.every((id) => sides[id] === "local");
        setSides(allInside ? DEFAULT_SIDE : { stt: "local", brain: "local", voice: "local" });
        return;
      }
      const part = target.closest<SVGGElement>(".line-part--movable");
      if (part) toggle(part.dataset.part as MovableId);
    });

    root.addEventListener("keydown", (event) => {
      if (event.key !== "Enter" && event.key !== " ") return;
      const part = (event.target as Element).closest<SVGGElement>(".line-part--movable");
      if (!part) return;
      event.preventDefault();
      toggle(part.dataset.part as MovableId);
    });

    function toggle(id: MovableId) {
      setSides({ [id]: sides[id] === "local" ? "provider" : "local" });
    }

    /* --- Packets --------------------------------------------------------- */

    type Packet = { el: SVGRectElement; dist: number; context: boolean; crossed: Set<number> };
    const packets: Packet[] = [];

    /** The whole request path as one polyline, with where each wire starts. */
    function route(d: Drawing, context: boolean) {
      const wires = context ? [d.layout.context] : d.layout.path;
      const points: Point[] = [];
      const wireStarts: number[] = [];
      let length = 0;
      wires.forEach((wire, i) => {
        const pts = wirePoints(d.pos[wire.from], d.pos[wire.to], wire.route);
        wireStarts.push(length);
        pts.forEach((p, j) => {
          if (i > 0 && j === 0) return;
          const prev = points[points.length - 1];
          if (prev) length += Math.hypot(p.x - prev.x, p.y - prev.y);
          points.push(p);
        });
      });
      return { points, wireStarts, length };
    }

    function pointAt(points: Point[], dist: number): Point {
      let left = dist;
      for (let i = 1; i < points.length; i++) {
        const a = points[i - 1];
        const b = points[i];
        const seg = Math.hypot(b.x - a.x, b.y - a.y);
        if (left <= seg) {
          const t = seg === 0 ? 0 : left / seg;
          return { x: a.x + (b.x - a.x) * t, y: a.y + (b.y - a.y) * t };
        }
        left -= seg;
      }
      return points[points.length - 1];
    }

    const outside = (layout: Layout, p: Point) =>
      layout.line.axis === "x" ? p.x > layout.line.at : p.y > layout.line.at;

    function spawn(d: Drawing, context: boolean) {
      const el = document.createElementNS(SVG_NS, "rect");
      const size = d.layout === TALL ? 6 : 7;
      el.setAttribute("width", String(size));
      el.setAttribute("height", String(size));
      el.setAttribute("x", String(-size / 2));
      el.setAttribute("y", String(-size / 2));
      el.classList.add("line-packet");
      d.packets.append(el);
      packets.push({ el, dist: 0, context, crossed: new Set() });
    }

    function flash(d: Drawing, at: Point) {
      const ring = document.createElementNS(SVG_NS, "circle");
      ring.classList.add("line-flash");
      ring.setAttribute("cx", String(at.x));
      ring.setAttribute("cy", String(at.y));
      d.flashes.append(ring);
      const start = performance.now();
      const grow = (now: number) => {
        const t = Math.min(1, (now - start) / FLASH_MS);
        ring.setAttribute("r", String(3 + t * 11));
        ring.setAttribute("opacity", String(1 - t));
        if (t < 1) requestAnimationFrame(grow);
        else ring.remove();
      };
      requestAnimationFrame(grow);
    }

    /* --- The loop -------------------------------------------------------- */

    let onScreen = false;
    let frame = 0;
    let last = 0;
    let sinceSpawn = SPAWN_MS;
    let sinceContext = 0;

    function tick(now: number) {
      frame = 0;
      const dt = last ? Math.min(64, now - last) : 16;
      last = now;
      stepTweens(now);
      const d = visible();
      if (d) {
        placeParts(d);
        if (!reduced) movePackets(d, dt);
      }
      if (onScreen && !document.hidden && (!reduced || tweens.size > 0)) {
        frame = requestAnimationFrame(tick);
      } else {
        last = 0;
      }
    }

    function movePackets(d: Drawing, dt: number) {
      sinceSpawn += dt;
      sinceContext += dt;
      if (sinceSpawn >= SPAWN_MS) {
        sinceSpawn = 0;
        spawn(d, false);
      }
      if (sinceContext >= CONTEXT_MS) {
        sinceContext = 0;
        spawn(d, true);
      }

      const main = route(d, false);
      const ctx = route(d, true);
      for (let i = packets.length - 1; i >= 0; i--) {
        const packet = packets[i];
        if (!d.packets.contains(packet.el)) {
          packets.splice(i, 1);
          continue;
        }
        const r = packet.context ? ctx : main;
        packet.dist += (SPEED * dt) / 1000;
        if (packet.dist >= r.length) {
          packet.el.remove();
          packets.splice(i, 1);
          continue;
        }
        const p = pointAt(r.points, packet.dist);
        packet.el.setAttribute("transform", `translate(${p.x.toFixed(1)} ${p.y.toFixed(1)})`);

        // Sound until speech to text, words until the voice, sound again after.
        const sound = !packet.context && (packet.dist < r.wireStarts[2] || packet.dist >= r.wireStarts[4]);
        packet.el.classList.toggle("line-packet--sound", sound);

        const isOut = outside(d.layout, p);
        if (isOut !== packet.el.classList.contains("is-outside")) {
          packet.el.classList.toggle("is-outside", isOut);
          const at =
            d.layout.line.axis === "x" ? { x: d.layout.line.at, y: p.y } : { x: p.x, y: d.layout.line.at };
          flash(d, at);
        }
      }
    }

    function wake() {
      if (!frame && onScreen && !document.hidden) frame = requestAnimationFrame(tick);
    }

    function clearPackets() {
      for (const packet of packets) packet.el.remove();
      packets.length = 0;
      sinceSpawn = SPAWN_MS;
    }

    new IntersectionObserver(
      ([entry]) => {
        onScreen = entry.isIntersecting;
        if (onScreen) wake();
        else clearPackets();
      },
      { rootMargin: "100px 0px" },
    ).observe(root);

    document.addEventListener("visibilitychange", () => {
      if (!document.hidden) wake();
    });

    // The layout can switch drawings on resize; stale packets belong to the
    // drawing that is no longer shown.
    window.matchMedia("(max-width: 639px)").addEventListener("change", clearPackets);

    labelParts();
  }
</script>
