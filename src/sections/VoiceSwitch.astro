---
/**
 * Section 3 — what changes when you stop typing.
 *
 * Two photographs of one screen, printed as a one-bit dither, and the reader's
 * own scroll drags the second one across the first, RIGHT TO LEFT. The
 * direction is the maintainer's, 2026-08-29; it is not derived from anything
 * else in the section and nothing else in the section depends on it. See
 * docs/section-3-voice.md.
 *
 * THE MONITOR IS THE SUBJECT. Both photographs are shot over the shoulder with
 * the screen square on, and the screen carries an editor: a file tree, a tab
 * row, code, a minimap, a terminal. The first version of this pair was side-on
 * and the screen was a bright smudge — the maintainer's complaint on
 * 2026-08-29 was that you could not tell what the picture was about.
 *
 * AND THE SCREEN IS THE ONLY THING IN COLOUR. The room prints in the two tokens
 * this site is made of; the code lines print in the app's own five stage hues,
 * because they are the one thing in the room that HAS a colour. The rule that
 * finds them is in scripts/dither-scene.py, and it is a property of the picture
 * rather than a box measured around this particular monitor.
 *
 * THE ARGUMENT IS THE INVERSION. The first frame is the room in daylight,
 * dithered as dark ink on paper; the second is the same room at night, the same
 * dots inverted to paper on ink. The page floor is that second ground, so the
 * wipe does not merely swap two pictures — it settles the section onto the
 * colour the rest of the site already stands on. The state the product is
 * selling is the one that stops fighting the page.
 *
 * THE SECTION IS EXACTLY ONE VIEWPORT, AND STILL SCROLLS. A tall track carries
 * a `position: sticky` viewport-height child: the reader scrolls three screens
 * of distance while seeing one screen of section, and that distance is what
 * drives the wipe. Nothing about the composition is allowed to exceed the
 * sticky box — every height between it and the picture is a flex chain with
 * `min-height: 0`, so the picture is the one element that gives, and the
 * headline, the caption and the figures are never pushed off the bottom.
 *
 * THE EDGE IS A DITHER, NOT A LINE. A hard rectangular clip is what the
 * reference does; here the boundary dissolves cell by cell on the same Bayer
 * matrix the frames were printed with, so the change reads as the picture's own
 * dots turning over rather than as one sheet sliding over another. See the
 * script below.
 *
 * Widths: one `content` container, and the head is a two-column grid inside it
 * — headline left, standfirst right. No width is named in this file;
 * docs/layout.md reserves that for widths.ts and layout.css, and
 * scripts/check-style.mjs enforces it.
 *
 * THE SECTION IS A FRAMED BOX WHILE IT IS PINNED, and the marker walks that
 * box's perimeter — down one rail, along the closing rule, then down the other
 * into the section below. The frame is what makes the box exist: the rails give
 * it two sides, and `[data-frame]` closes it top and bottom. The marker goes
 * inside that frame rather than on the section element, which is three screens
 * tall and would put the halfway point a screen and a half below the fold.
 * Which rail it enters on alternates down the page and is not this section's to
 * decide — see src/components/SectionTrack.astro.
 */
import Container from "@/components/Container.astro";
import SectionTrack from "@/components/SectionTrack.astro";

/**
 * `?url` rather than astro:assets: these are one-bit dither, and the build's
 * image pipeline would re-encode them. Every dot carries tone here.
 *
 * Regenerate with `python scripts/dither-scene.py <manual-src> <voice-src>`.
 * The palette is baked in, so a token change means re-running that script.
 */
import jarvisFrame from "@/assets/scene/voice.png?url";
import manualFrame from "@/assets/scene/manual.png?url";

/**
 * One caption per state, under the picture. Each says what the app does, not
 * what the photograph shows — someone who only looks at the two frames learns
 * that hands come off the keyboard, which is not the same as learning what
 * Dodaios is.
 *
 * Everything here is in the app README: the wake word you choose, the tool
 * model that decides how much a request needs, the coding-agent worker running
 * in an isolated copy of the workspace, and the answer spoken back in the
 * language you used. Nothing is a promise the app cannot keep.
 */
const captions = {
  manual: {
    lead: "Hands on the keyboard.",
    rest: "You find the window, the tab and the right button, then read the result yourself.",
  },
  jarvis: {
    lead: "Hands nowhere near it.",
    rest: "You say it out loud. It picks the tools, takes the mouse if it has to, and answers in the language you used.",
  },
};

/**
 * What the man in the night frame is saying, one word per span.
 *
 * IT IS A REQUEST, NOT A GREETING. The section's claim is that real work goes
 * to a coding agent in an isolated copy of your files, so the sentence has to be
 * a job somebody would actually hand over — and one the app can honestly take.
 * "Hey Dodaios" stands in for the wake word here; the
 * app's own is whatever the owner picks.
 *
 * The words arrive ONE AT A TIME as the reader scrolls. They are NOT split
 * here any more: the painter sets this sentence itself, so it reads the line
 * off the element below and splits it there. One copy of the words, in the one
 * place a reader who is listening to the page can still reach them.
 */
const said = "Hey Dodaios, the tests are red. Find out why and fix it.";

/**
 * The figures under the picture. Each is countable in the app's own source;
 * none is a marketing number, and nothing here may be invented.
 *
 * They do NOT change with the state. Every provable figure is a fixed property
 * of the app with no "before" counterpart, and inventing one would be exactly
 * what docs/section-3-voice.md forbids. Approved by the maintainer 2026-08-28,
 * together with the decision that the bar stays static.
 */
const figures = [
  {
    value: "32",
    label: "Providers",
    // 12 brain + 8 speech-to-text + 8 text-to-speech + 4 realtime voice,
    // counted from the dodaios.* entry points in the app's pyproject.toml.
    note: "Brain, voice in, voice out",
  },
  { value: "3", label: "Platforms", note: "Windows, macOS, Linux" },
  { value: "< 1 s", label: "Spoken reply", note: "Realtime model" },
  { value: "4", label: "Channels", note: "One brain, one memory" },
];
---

<section
  id="voice"
  aria-labelledby="voice-heading"
  class="relative"
  data-voice-switch
  data-mode="manual"
>
  <!--
    THERE IS NO OPENING `.section-rule` HERE, and adding one back is the bug.
    This section already draws its two boundary rules on the pinned frame
    below, an inset inside the sticky viewport. A rule up here drew a THIRD
    line, 76px above the frame's own top line — the doubled boundary the
    maintainer reported on 2026-08-29, and with the card border of the section
    above it in the same view, three lines at one joint.

    The frame's two lines and the inset around them are the standard shell
    reached from the other direction: this box is inside a sticky child three
    screens down and cannot use `.section-bounds`, so `[data-viewport]` takes
    `--section-inset` as its padding and `[data-frame]` draws the rules. Same
    two numbers as every other section. See docs/layout.md § "One boundary, one
    shape".
  -->

  <!--
    The scroll track. Its only job is to be tall — the height IS the animation's
    running length, and the sticky child inside it is what the reader sees.

    Below the desktop breakpoint the track collapses to `auto` (see the styles)
    and the section becomes an ordinary block. A three-screen scroll trap on a
    phone is a worse experience than no animation — but the wipe still runs,
    because it reads THIS element's passage through the window and this element
    is the right box either way.
  -->
  <div data-track data-scroll-span>
    <div data-viewport>
      <Container width="content" class="flex h-full min-h-0 flex-col">
        <!--
          The pinned frame. Its four edges are the section: the two rails
          stand on the container this sits in, and these two hairlines close
          the box top and bottom. That box is what the section marker walks,
          which is why the marker goes INSIDE it rather than on the section —
          the section element is three screens tall, and a marker halfway
          down it would be a screen and a half below the fold.
        -->
        <div data-frame>
          <SectionTrack nested />

          <p class="uppercase text-muted" data-eyebrow>What changes</p>

          <div data-head>
            <h2 id="voice-heading" class="text-balance" data-headline>
              Most assistants talk back.<br />This one does the thing.
            </h2>

            <p class="text-pretty" data-standfirst>
              It runs on your own machine and answers to a name you pick. Small
              things it does itself — opens the app, changes the setting, takes
              the mouse. Real work goes to a coding agent in an isolated copy of
              your files and comes back finished.
            </p>
          </div>

          <!--
            The picture is the one element allowed to give: `flex: 1` on a
            `min-height: 0` chain, so a short window shrinks the photograph
            instead of pushing the figures past the fold.
          -->
          <figure data-figure>
            <div data-stage>
              <!--
                Both frames are in the markup from the first paint: the canvas
                draws from these elements, and a frame fetched on the first
                switch would flash an empty box. They are hidden from layout, not
                from the accessibility tree — the alt text is the picture for a
                reader who cannot see the canvas, which is aria-hidden.
              -->
              <img
                src={manualFrame}
                width="640"
                height="360"
                loading="eager"
                decoding="async"
                alt="A home office in hard daylight, printed as fine dark dots on paper white, seen over the shoulder of a person hunched at the desk with both hands on the keyboard. The wide monitor facing the camera shows a code editor buried under a dozen overlapping panels, its tab row crammed and its terminal full. A mug, a plant and a slipped stack of papers sit at the left, a bright window behind."
                data-source="manual"
              />
              <img
                src={jarvisFrame}
                width="640"
                height="360"
                loading="eager"
                decoding="async"
                alt="The same desk, the same room, the same mug and plant, at night, from the same place over the shoulder. The dots have inverted to light on black. The person has sat back with both hands away from the keyboard and mouse, head up, speaking into a microphone on a boom arm. The same editor is on the monitor, now down to a single tidy column of code in colour with empty space around it."
                data-source="jarvis"
              />

              <!--
                The canvas is the picture, so it carries the picture's name.
                It used to be `aria-hidden` under a `role="tabpanel"` labelled
                by whichever button was pressed; the buttons went on
                2026-08-29 and the label went with them, which would have left
                the one visible element of the section unnamed.
              -->
              <canvas
                data-canvas
                role="img"
                aria-label="One desk in two states, dissolving from the first into the second as the page scrolls: by hand in hard daylight, hunched over a keyboard under a screenful of overlapping panels; then the same desk at night, sat back with both hands away, speaking into a microphone, the same editor down to one tidy column of code."
              ></canvas>

              <!--
                THE SPEECH BUBBLE, AND WHY ONLY ITS SENTENCE IS HERE.

                It was drawn into the dot grid by scripts/dither-scene.py until
                2026-08-29 — empty, three dots in it, a wide wedge of a tail
                running down across the man's head. It then spent a day as two
                elements laid OVER the canvas: ordinary type on a rounded box,
                with the tail as an SVG path. Both versions are gone.

                The burnt-in one could not be typeset, could not animate, and
                could not move without the photograph being regenerated. The
                laid-over one could do all three and broke the picture instead:
                a smooth radius, a feathered edge and antialiased type are three
                things that exist nowhere else in a one-bit print, so the bubble
                read as an interface element sitting on a photograph. That is
                the maintainer's complaint of 2026-08-29 — it killed the theme.

                So the bubble is PRINTED WITH THE PICTURE now: the same canvas,
                the same Bayer matrix and the same dot the photograph is printed
                with, drawn at run time so it is still typeset, still arrives one
                word at a time, and still follows the crop. Its edge dissolves
                into dots exactly the way the wipe's does, and its words build up
                out of the dots rather than fading in over them. See
                `printBubble` in the script below.

                What stays here is the sentence, for a reader who is listening
                to the page rather than looking at it — and the painter reads its
                words off this element, so the line is written once. The type is
                still set by the stylesheet, because that is where the painter
                reads the font from.
              -->
              <p data-bubble>{said}</p>
            </div>

            <figcaption data-caption>
              {
                (["manual", "jarvis"] as const).map((mode) => (
                  <span data-caption-for={mode} hidden={mode !== "manual"}>
                    <strong>{captions[mode].lead}</strong> {captions[mode].rest}
                  </span>
                ))
              }
            </figcaption>
          </figure>

          <dl data-figures>
            {
              figures.map(({ value, label, note }) => (
                <div>
                  <dt>
                    <span data-figure-label>{label}</span>
                    <span data-figure-note>{note}</span>
                  </dt>
                  <dd>{value}</dd>
                </div>
              ))
            }
          </dl>
        </div>
      </Container>
    </div>
  </div>
</section>

<style>
  /* --- The track and its one visible screen -------------------------------
   *
   * `--track` is the animation's running length. The reader scrolls
   * (track - viewport) of distance; everything the script does is a fraction of
   * that. Three screens is enough for the wipe to feel deliberate and short
   * enough that nobody thinks the page has stopped.
   */
  [data-track] {
    --track: 300svh;

    height: var(--track);
  }

  [data-viewport] {
    position: sticky;
    /* PINNED UNDER THE NAV, IN A BOX THE HEIGHT OF `--section-height`, so this
     * section's two rules stand exactly where an ordinary section's do. The nav
     * is fixed over the whole document since 2026-08-29, and the page rests a
     * section boundary `--nav-height` below the top of the window; a child
     * pinned at `top: 0` and a whole `100svh` tall therefore sat 76px higher
     * than the section it belongs to, and its frame jumped by that much between
     * the moment the section snapped and the moment the pin took hold. Pinning
     * at the same offset the snap uses removes the jump, and taking `2 x
     * --nav-height` off the height is what leaves the closing rule the same air
     * the opening one has. The derivation is in layout.css § "Section
     * heights". */
    top: var(--nav-height);
    height: var(--section-height);
    /* `--section-inset`, top and bottom, because this padding IS this section's
     * inset: it is the air between the section's own edge and the frame's two
     * rules, which is what every other section spends on `.section-inset`. */
    padding-block: var(--section-inset);
    overflow: hidden;
  }

  /* --- The pinned frame --------------------------------------------------
   * The section drawn as a box: the rails give its two sides, these two rules
   * close it top and bottom, and the section marker walks that perimeter.
   * They are `--rule` and not `--hairline` for that reason — this is the
   * page's structure, not the edge of an object, and it is the same line the
   * rails and every `.section-rule` draw.
   *
   * It is inset from the sticky viewport rather than flush with it,
   * because a closing line lying on the bottom edge of the window is a line
   * nobody sees — and the reader is meant to watch the marker turn that corner.
   *
   * It carries the flex chain on from the container: `min-height: 0` here as
   * well, or the picture stops being the element that gives and the figures go
   * through the bottom of the frame.
   */
  [data-frame] {
    position: relative;
    display: flex;
    flex: 1 1 auto;
    min-height: 0;
    flex-direction: column;
    border-block: 1px solid var(--rule);
    padding-block: var(--space-lg);
  }

  /* --- The text is held off the rails ------------------------------------
   * The two rails stand on the container's own content edges, so a paragraph
   * inside it starts on exactly the pixel the rail is drawn on and every line
   * reads as stuck to the frame. The maintainer's complaint, 2026-08-29.
   *
   * The inset is `--space-base` because that is what the figure cells already
   * pad by: the eyebrow, the headline, the caption and the figure labels then
   * all start on ONE vertical line a fixed distance inside the rail, rather
   * than the bar being inset and everything above it not.
   *
   * IT GOES ON THE CHILDREN, NEVER ON `[data-frame]`. The section marker's
   * layer is `position: absolute; inset: 0` against that element's padding
   * box, and the marker is supposed to ride the rails — inline padding there
   * pulls it a gutter inside both of them and it walks down the middle of the
   * section instead. Same rule as `.section-bounds` in layout.css.
   *
   * The picture and the figure bar are deliberately NOT inset. They are
   * objects with a 1px border of their own in the rail's own colour, and that
   * border IS the rail for their height; holding them off it would break both
   * lines for the height of the photograph.
   */
  [data-frame] {
    --text-inset: var(--space-base);
  }

  [data-eyebrow],
  [data-head],
  [data-caption] {
    padding-inline: var(--text-inset);
  }

  /* --- The head ----------------------------------------------------------
   * Headline left, standfirst right, both starting on the same baseline row.
   * 7:6 rather than 1:1 — the headline is display type and needs the wider
   * half to break where it was written to break.
   */
  [data-eyebrow] {
    /* From the token rather than Tailwind's `text-sm`: the tokens travel with
     * the root scale, so the label and the headline grow together. */
    font-size: var(--text-body-sm);
    letter-spacing: 0.1em;
  }

  [data-head] {
    display: grid;
    gap: var(--space-md) var(--space-xxl);
    align-items: start;
    margin: var(--space-md) 0 var(--space-lg);
  }

  /* 8:5, not 7:6. The split is set by the headline, not by taste: at 7:6 the
   * first sentence is two characters wider than its column and wraps, which
   * turns a two-line headline into three and pushes "talk back." onto a line of
   * its own. The standfirst has slack to give; the display line does not. */
  @media (min-width: 900px) {
    [data-head] {
      grid-template-columns: minmax(0, 8fr) minmax(0, 5fr);
    }
  }

  [data-headline] {
    margin: 0;
    font-size: var(--text-display-xl);
    letter-spacing: var(--tracking-display-xl);
    line-height: 1.1;
  }

  [data-standfirst] {
    margin: 0;
    /* The standfirst is set beside display type, so it starts on the headline's
     * first baseline rather than the top of its box. */
    padding-top: 0.4em;
    color: var(--body);
    font-size: var(--text-body);
    line-height: 1.6;
  }

  /* --- The picture -------------------------------------------------------
   * The flex chain that keeps the section inside one screen: the figure takes
   * the leftover height, the stage takes the leftover inside that, and both
   * carry `min-height: 0` so a flex item is actually allowed to shrink below
   * its content. Without that pair the canvas holds its aspect ratio and
   * shoves the figures through the bottom of the viewport.
   */
  [data-figure] {
    display: flex;
    flex: 1 1 auto;
    min-height: 0;
    flex-direction: column;
    margin: 0;
  }

  [data-stage] {
    position: relative;
    flex: 1 1 auto;
    min-height: 0;
    overflow: hidden;
    /* `--rule`, because this border stands ON the two rails: the picture is as
       wide as the content column, so its left and right edges are the rails at
       this height and have to be the same line. A hairline here made the rails
       stop dead for the height of the picture and start again below it. */
    border: 1px solid var(--rule);
    border-radius: var(--radius-xl);
    /* The manual frame's own paper, so the box reads as one sheet before the
     * canvas has painted and while the first frame is still in front. */
    background: var(--ink);
  }

  [data-canvas] {
    display: block;
    width: 100%;
    height: 100%;
  }

  /* The source frames feed the canvas and carry the alt text; they are never
   * painted. `visibility: hidden` rather than `display: none` — a display-none
   * image is not guaranteed to be fetched, and the canvas needs it decoded. */
  [data-source] {
    position: absolute;
    width: 1px;
    height: 1px;
    visibility: hidden;
  }

  /* --- The speech bubble --------------------------------------------------
   *
   * PAPER ON THE NIGHT PICTURE. The night frame is `--canvas` ground with
   * `--ink` dots, so a bubble filled with `--ink` is simply that frame's own
   * mark at full coverage — the one patch of the picture that is completely
   * inked in — and the words are the ground showing back through. That is the
   * printing this whole section is an argument about, and it is why the bubble
   * needs no outline: a shape at 100% coverage on a 22% ground already has one.
   *
   * NONE OF IT IS DRAWN HERE ANY MORE. The bubble was a positioned box with a
   * radius, a background and an opacity until 2026-08-29, laid over the canvas;
   * it is printed into the canvas now, so CSS owns exactly two things about it:
   * that the sentence is not shown, and what type it is set in. The painter
   * reads the font off this element, which is what keeps the bubble's
   * typography on the tokens instead of on a literal in the script.
   *
   * THE SIZE HERE IS A FLOOR, NOT THE SIZE. A printed line needs a minimum
   * number of DOTS to survive the threshold, and the dot belongs to the
   * photograph, so the painter raises this figure whenever the crop prints
   * coarser than that. Lowering it does not make the sentence smaller past that
   * point; see TYPE_DOTS in the script.
   *
   * Hidden the way a caption for a screen reader is hidden, never with
   * `display: none` or `visibility: hidden`: the sentence is the only place the
   * spoken line exists in the accessibility tree, and both of those would take
   * it out of it.
   */
  [data-bubble] {
    position: absolute;
    width: 1px;
    height: 1px;
    margin: 0;
    overflow: hidden;
    clip-path: inset(50%);
    white-space: nowrap;
    font-size: var(--text-body-sm);
    line-height: 1.4;
  }

  /* On a phone the picture is barely 330px across, so the sentence printed on it
   * comes down a step with it. Type size only: the painter reads the font off
   * this element, which is what keeps the printed bubble on the tokens.
   *
   * Width, deliberately, unlike the layout block further down — this is about
   * how wide the picture is, not about whether the section is pinned. */
  @media (max-width: 1023px) {
    [data-bubble] {
      font-size: var(--text-caption);
    }
  }

  /* --- Caption -----------------------------------------------------------
   * Both captions reserve the same box, so the state change does not shove the
   * figures up and down the page. They are stacked rather than toggled with
   * `hidden` at runtime: a caption that disappears for a frame between two
   * states flickers, and the box has to hold the taller of the two anyway.
   *
   * CENTRED, and it is the only line in the section that is. It is the one
   * piece of text that belongs to the picture rather than to the column — it
   * changes when the picture changes and says nothing on its own — so it is
   * set to the picture's own centre instead of joining the left edge the
   * eyebrow, the headline and the figures share. Maintainer's call,
   * 2026-08-29.
   */
  [data-caption] {
    display: grid;
    justify-items: center;
    margin: var(--space-md) 0 0;
    color: var(--muted);
    font-size: var(--text-body-sm);
    line-height: 1.5;
    text-align: center;
  }

  [data-caption] > span {
    grid-area: 1 / 1;
    transition: opacity 160ms ease;
  }

  [data-caption] > span[hidden] {
    display: block;
    opacity: 0;
  }

  [data-caption] strong {
    color: var(--ink);
    font-weight: 600;
  }

  /* --- The figures -------------------------------------------------------
   * Hairlines are the 1px gaps of a grid on a hairline-coloured ground, the
   * same technique the logo strip uses. No borders are drawn.
   *
   * THE INLINE BORDER IS THE RAILS, NOT A NUDGE. The cells are filled in the
   * page colour and the bar spans the whole column, so without it the bar
   * paints over both rails for its own height and the two lines that frame the
   * section stop dead for 100px and start again below. The border draws the
   * rail's own colour on the rail's own pixel instead, and the rails read as
   * continuous. The picture above solves the identical problem with its own
   * 1px border; docs/layout.md § "Page chrome" names this bar as the case to
   * watch.
   *
   * It used to be `padding-inline: 1px`, letting a pixel of the grid's own
   * hairline ground show at each outer edge. That worked only while the rails
   * and the internal dividers were the same colour. They are two different
   * jobs and now two different tokens (`--rule` against `--hairline`), so the
   * edge has to name the one it is actually continuing.
   */
  [data-figures] {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 1px;
    /* The outer edge is a BORDER in `--rule` rather than a pixel of the grid's
       own ground showing through `padding-inline`, because the two colours are
       no longer the same one. The ground stays `--hairline` — that is what the
       internal dividers are made of, and they bound cells, not the page. The
       border is what the rails are made of, and it lands on exactly the pixel
       the padding used to. Border-box sizing keeps the grid the same width. */
    border-inline: 1px solid var(--rule);
    background: var(--hairline);
    margin: var(--space-lg) 0 0;
  }

  @media (min-width: 768px) {
    [data-figures] {
      grid-template-columns: repeat(4, minmax(0, 1fr));
    }
  }

  [data-figures] > div {
    display: flex;
    flex-direction: column-reverse;
    align-items: baseline;
    gap: var(--space-xxs);
    background: var(--canvas);
    padding: var(--space-md) var(--space-base);
  }

  /* EVERY CELL RUNS THE SAME WAY, LEFT TO RIGHT — including the last one.
   *
   * It was turned round for a while: four short facts do not fill a column
   * this wide, and the fourth cell's slack sat against the RAIL with nothing
   * after it, which read as the bar failing to reach the edge of the section.
   * Setting that one cell flush right closed the gap and cost the row its
   * rhythm — the maintainer's complaint on 2026-08-29 was that the last card
   * ran the other way from the other three. A row of four that reads in two
   * directions is worse than a row of four with a wide last gutter, so the
   * slack stays and the direction is uniform. Do not turn it round again. */

  [data-figures] dd {
    margin: 0;
    color: var(--ink);
    font-size: var(--text-display-md);
    letter-spacing: var(--tracking-display-md);
    line-height: 1;
  }

  [data-figures] dt {
    display: flex;
    flex-direction: column;
    gap: 2px;
  }

  [data-figure-label] {
    color: var(--ink);
    font-size: var(--text-caption-upper);
    font-weight: 600;
    letter-spacing: var(--tracking-caption-upper);
    text-transform: uppercase;
  }

  [data-figure-note] {
    color: var(--muted);
    font-size: var(--text-caption);
  }

  /* --- Where the sticky layout is dropped --------------------------------
   * Three cases drop out of it into an ordinary block: no tall scroll
   * distance, no sticky child, and the picture back at its own 16:9.
   *
   *   narrow    a three-screen scroll trap on a phone is worse than no
   *             animation, and the head's two columns have collapsed anyway
   *   short     the flex chain gives the picture whatever height is left, and
   *             below about 880px of PINNED BOX that is a 4:1 letterbox slot
   *             the photograph cannot survive — measured, not assumed: at that
   *             crop the picture is down to the monitor and the head, and the
   *             keyboard and the two hands are outside it. The query below asks
   *             for 1030px of WINDOW, because the box is `--section-height` and
   *             not `100svh` any more: it is `2 x --nav-height` shorter than
   *             the window it is measured in, so the same box needs that much
   *             more window to exist. The 880 is the figure that was measured
   *             and the one to re-measure; 1030 is 880 plus the page chrome.
   *   calm      prefers-reduced-motion
   *
   * THIS IS A GEOMETRY DECISION AND NOTHING ELSE. It used to be a mode: the
   * script read the same three queries, turned the scrub off in all of them,
   * and handed control to two buttons in the picture's corner. The buttons
   * went on 2026-08-29 and the wipe now reads the track's own passage through
   * the window, which is the correct input whether that track is three screens
   * tall or one block high — so only `calm` still means anything to the
   * script, and there is no longer a pair of conditions to keep spelled alike.
   */
  @media (max-width: 1023px), (max-height: 1029px), (prefers-reduced-motion: reduce) {
    [data-track] {
      height: auto;
    }

    [data-viewport] {
      position: static;
      height: auto;
      padding-top: var(--space-xxl);
      padding-bottom: var(--space-xxl);
      overflow: visible;
    }

    [data-stage] {
      flex: 0 0 auto;
      aspect-ratio: 16 / 9;
    }

    /* Nothing is pinned, so there is no box for a perimeter to be the
     * perimeter OF: the frame's own two lines would float in the middle of an
     * ordinary block, and the section keeps its rule at the top like every
     * other one instead.
     *
     * The marker stays, and the box it walks grows to the section's own edges:
     * the negative margin and the equal padding cancel each other, so nothing
     * moves on the page and the box simply reaches out through the sticky
     * viewport's padding to where the rules actually are. */
    [data-frame] {
      display: block;
      border-block: 0;
      margin-block: calc(-1 * var(--space-xxl));
      padding-block: var(--space-xxl);
    }
  }

  @media (prefers-reduced-motion: reduce) {
    [data-caption] > span {
      transition: none;
    }
  }
</style>

<script>
  /*
   * The wipe.
   *
   * One canvas, two source frames, and a boundary that dissolves cell by cell
   * instead of cutting a straight line.
   *
   * WHY A DITHERED EDGE. Both frames are printed with an ordered Bayer matrix,
   * so the picture is already a grid of dots. A straight-edged clip crosses
   * that grid and reads as one sheet sliding over another. Running the same
   * matrix along the boundary makes the cells turn over in the frames' own
   * rhythm — the picture changes rather than moves, which is the claim the
   * section is making.
   *
   * WHY A MASK CANVAS AND NOT A CLIP PATH. The dissolve zone is a few thousand
   * cells. As a path that is a few thousand sub-paths to clip against, per
   * frame. As a mask it is one small ImageData — one cell per pixel — scaled up
   * with smoothing off and composited in a single `destination-in`. Three
   * drawImage calls a frame either way, and the cost stops depending on how
   * wide the zone is.
   */

  import { TURN_DOWN, downTheRail } from "@/lib/sectionTrack";
  import { trackProgress } from "@/lib/scrollSpan";

  /** Ordered threshold matrix, 8x8. The same one scripts/dither-scene.py prints
   * the frames with, so the dissolve lands in the frames' own rhythm. */
  const BAYER = (() => {
    let m = [
      [0, 2],
      [3, 1],
    ];
    while (m.length < 8) {
      const n = m.length;
      const next: number[][] = [];
      for (let y = 0; y < n * 2; y++) next.push(new Array(n * 2).fill(0));
      for (let y = 0; y < n; y++) {
        for (let x = 0; x < n; x++) {
          const v = m[y][x] * 4;
          next[y][x] = v;
          next[y][x + n] = v + 2;
          next[y + n][x] = v + 3;
          next[y + n][x + n] = v + 1;
        }
      }
      m = next;
    }
    return m.map((row) => row.map((v) => (v + 0.5) / 64));
  })();

  /** A dissolve cell, in CSS pixels. Larger than a printed dot on purpose: the
   * edge has to be legible as it crosses the picture, not invisible. */
  const CELL = 10;

  /** Width of the dissolve zone as a fraction of the stage. Wide enough that
   * several cells are mid-turn at once; narrow enough to still read as an edge
   * travelling rather than the whole picture fading. */
  const BAND = 0.16;

  /** WHERE THE WIPE SITS ON THE SECTION MARKER'S PATH.
   *
   * The marker walks the section's perimeter (src/lib/sectionTrack.ts), and the
   * wipe is timed against it rather than against a pair of hand-set numbers:
   * the picture starts turning over three quarters of the way down the LEFT
   * rail, and is finished the moment the marker turns the BOTTOM-RIGHT corner —
   * which is also the moment the section stops being the thing the reader is
   * scrolling. So the reader arrives on a finished picture, watches it change
   * while the marker crosses the closing rule, and leaves on the other one with
   * the marker heading down into the next section.
   *
   * Tying the two together is the point. Two independent numbers drift, and the
   * defect that produces is one anybody notices: the photograph finishes
   * changing while the marker is still halfway along the bottom line. */
  const WIPE_FROM = downTheRail(0.75);
  const WIPE_TO = TURN_DOWN;

  /** The vertical anchor of the crop: 42%, not 50%.
   *
   * The stage is much wider than 16:9 once the flex chain has taken its height,
   * so a centred crop cuts the desk edge away. Biasing upward keeps the head,
   * the bubble and the desk in frame and loses ceiling instead.
   *
   * It used to be a bare literal inside the draw call, paired by a comment with
   * a hand-measured box in the Python script. Both the picture and the bubble
   * read it from here now, so the pair cannot drift. */
  const ANCHOR = 0.42;

  /* --- The speech bubble's geometry, in fractions of the FRAME -------------
   *
   * Fractions of the photograph, never of the stage: the stage is cropped and
   * its shape changes with the window, the photograph does not. The script maps
   * these through the same cover-crop the canvas paints with.
   *
   * MEASURED ON THE NIGHT FRAME, and the two that touch the man have to be
   * re-measured if that photograph is ever regenerated. The wall above his head
   * is empty from the top of the frame down to the hairline at 0.396, and the
   * boom arm crosses below that.
   */

  /** The bubble's bottom-right corner. It grows up and to the left from here,
   * so the corner nearest the tail stays put however the text wraps. */
  const BUBBLE_AT = [0.972, 0.302] as const;

  /** The lips, measured: the lit edge of the profile, just past the near end of
   * the microphone. The tail points here. */
  const MOUTH = [0.818, 0.512] as const;

  /** Where the tail leaves the bubble's bottom edge, and where it stops.
   *
   * IT STOPS AT THE HAIRLINE, which is the whole point of the number. The
   * previous tail was a wedge that ran all the way to the lips, straight down
   * across the man's head — the maintainer's complaint on 2026-08-29 was that
   * it hung in his face. This one keeps the direction and gives up the last
   * two thirds of the journey: it leans at exactly the angle that would reach
   * the mouth and ends above the hair, so the reader's eye finishes the line.
   *
   * TAIL_MIN is the floor under that. On a very short window the bubble is
   * pushed down to stay inside the stage and the gap to the hairline closes; a
   * tail of nothing reads as a bug, so it keeps 14px and accepts the overlap. */
  const TAIL_AT = 0.868;
  const TAIL_END = 0.376;
  const TAIL_MIN = 14;
  const TAIL_HALF = 11;
  const TAIL_BULGE = 5;

  /** Air between the bubble and the top of the stage. The stage clips, so this
   * is what stops a three-line bubble losing its first line. */
  const BUBBLE_AIR = 10;

  /** The bubble's own box, in CSS pixels rather than in fractions of the frame.
   *
   * Everything else about the bubble is borrowed from the photograph — its dot,
   * its lattice, its Bayer phase — but its SIZE cannot be, because it carries
   * words. The crop scales the frame well below its printed size on a short
   * window, and a sentence that went down with it would be four pixels tall. So
   * the box holds its reading size and only the printing is borrowed.
   *
   * Floor plus share, the same shape as every width on this site: a share of a
   * wide stage, and a pixel floor so a phone-width stage still gets a readable
   * line rather than a column of single words. They were `max(208px, 27%)` in
   * the stylesheet until the bubble moved into the canvas. */
  const BUBBLE_MIN_W = 208;
  const BUBBLE_SHARE = 0.27;

  /** The widest the box may be, as a share of the stage.
   *
   * A ceiling, not a size: it only bites where the picture is so small that a
   * line of TYPE_DOTS dots would need a box wider than the photograph under it.
   * The size gives way there rather than the box, and the sentence is set at
   * whatever the stylesheet asks for — a small picture and a legible sentence
   * cannot both be had, and a bubble hanging over the edge of its own frame is
   * the worse of the two failures. */
  const BUBBLE_MAX_SHARE = 0.62;

  /** The line's own floor on the box, in ems of the printed face.
   *
   * The box has to grow with its type or a wide stage sets a large sentence
   * into the same narrow column and wraps it into a stack of single words.
   * Fifteen ems holds this sentence in three lines at every size the section
   * is drawn at. */
  const BUBBLE_EMS = 15;

  /** The box's padding and its corner, in EMS OF THE PRINTED SENTENCE rather
   * than in CSS pixels. They were 14px, 9px and 16px against a fixed 14px line
   * until 2026-08-29; the type is set by the dot now, so a padding nailed to
   * pixels closed up the moment the line grew. The ratios are those numbers. */
  const BUBBLE_PAD_X = 1;
  const BUBBLE_PAD_Y = 0.64;
  const BUBBLE_RADIUS = 1.15;
  const LINE_HEIGHT = 1.4;

  /** The smallest dot worth setting a sentence on, in CSS pixels.
   *
   * A dot is one pixel of the 720-wide source as the crop has just scaled it,
   * which on a wide stage is already around 1.7 CSS pixels — so this changes
   * nothing there. It bites on a stage narrower than the source, where the
   * picture's own dot drops under a pixel and type printed on it would come out
   * antialiased mush. The bubble then prints on a whole multiple of that dot:
   * bigger blocks of the SAME lattice, never a lattice of its own.
   *
   * ONE, not 1.6. A dot smaller than a pixel is not a dot, and that is the only
   * thing this floor has left to say. It stood at 1.6 while the sentence was
   * set at a flat 14px, where it was standing in for a type size: coarser dots
   * were the only way a phone-width crop kept the line big enough to read. That
   * is TYPE_DOTS' job now, and the two together were worse than either — the
   * size follows the dot, so a floor above the picture's own dot printed a
   * sentence wider than the photograph carrying it. */
  const DOT_MIN = 1;

  /** The bubble's edge, in dots and in coverage.
   *
   * THE EDGE IS A DITHER, NOT A LINE — the same rule the wipe underneath it
   * runs on. A shape that stops on a clean boundary is the one thing that gave
   * the laid-over bubble away even after everything else about it was printed:
   * nothing else in this picture has an edge that is not made of dots. So the
   * last two dots of the bubble are printed at half coverage, which the matrix
   * turns into a boundary that thins out instead of ending.
   *
   * Outside the fill, never inside it: the fill is laid over the fray, so the
   * body stays at full coverage and only the dots beyond it are thinned. A fray
   * that ate into the box would put holes under the sentence. */
  const EDGE_FRAY = 3;
  const EDGE_COVER = 0.5;

  /** The floor under the printed sentence, in DOTS PER EM.
   *
   * THIS IS WHAT MAKES THE LINE READABLE. The bubble is printed in the
   * photograph's own dot — about 1.7 CSS pixels on a wide stage — and the
   * sentence was set from the stylesheet at a flat 14px, so every glyph was
   * rasterised into roughly eight dots before the matrix ever saw it. Eight
   * dots per em is below the floor any face has: an `e` is four dots tall, its
   * counter is one, and a threshold closes it. The letters came out as mush,
   * which is the maintainer's report of 2026-08-29, and no tuning of the
   * threshold below could have rescued them — the resolution was the fault.
   *
   * So the SIZE OF THE LINE FOLLOWS THE DOT, not the stylesheet: whatever the
   * tokens ask for, the painter sets the line at no fewer than this many dots.
   * Fourteen is the smallest count that still holds a stem and an open counter
   * once the threshold has been through it — an x-height of ten dots, stems of
   * one and a bit. The stylesheet keeps the family, the weight and the floor
   * under the size; the photograph decides how coarsely they are printed.
   *
   * Raising it prints a bigger sentence, never a sharper one — the dot does not
   * move — so it is a legibility floor and not a size control. */
  const TYPE_DOTS = 14;

  /** How much of a glyph a dot has to be covered by before it prints.
   *
   * Half of it, which is simply the glyph's own outline: at fourteen dots per
   * em a stem covers more than half the dots under it and a counter covers
   * less, so the true shape survives the pass. It was 96 while the type was set
   * at nine dots, where a middling threshold dropped whole stems — that bought
   * back the stems at the price of a halo that closed up every counter, and the
   * reason for the trade is gone now that TYPE_DOTS sets the size. */
  const TYPE_FLOOR = 128;

  /** Where the bubble and its words sit on the wipe.
   *
   * The bubble fades in while the dissolve is crossing its own corner — the
   * edge travels right to left, so the top right of the picture turns over
   * between roughly 0.28 and 0.40 — and the sentence is said across the back
   * half, finishing early enough to be read before the section lets go.
   *
   * Nothing appears on the daylight frame, because nobody is speaking in it. */
  const BUBBLE_FROM = 0.26;
  const BUBBLE_TO = 0.4;
  const WORDS_FROM = 0.42;
  const WORDS_TO = 0.85;

  /** ~30fps. The frames are a dot grid; the extra 30 buy nothing visible and
   * cost a full repaint of the stage. */
  const FRAME_MS = 33;

  const section = document.querySelector<HTMLElement>("[data-voice-switch]");

  if (section) {
    const track = section.querySelector<HTMLElement>("[data-track]")!;
    const stage = section.querySelector<HTMLElement>("[data-stage]")!;
    const view = section.querySelector<HTMLCanvasElement>("[data-canvas]")!;
    const bubble = section.querySelector<HTMLElement>("[data-bubble]")!;

    /* The sentence, read off the one element that carries it. It is written
     * once, in the markup, where a screen reader can still reach it. */
    const words = (bubble.textContent ?? "").trim().split(/\s+/).filter(Boolean);
    const captions = Array.from(section.querySelectorAll<HTMLElement>("[data-caption-for]"));
    const sources = (["manual", "jarvis"] as const).map(
      (name) => section.querySelector<HTMLImageElement>(`[data-source="${name}"]`)!,
    );

    const ctx = view.getContext("2d");
    const layer = document.createElement("canvas");
    const layerCtx = layer.getContext("2d");
    const mask = document.createElement("canvas");
    const maskCtx = mask.getContext("2d", { willReadFrequently: true });

    /* The bubble's own sheet: ONE PIXEL PER PRINTED DOT, blown up onto the
     * stage with smoothing off. That is the whole trick, and it is the same one
     * the photographs are drawn with — a bubble drawn straight onto the stage
     * would be drawn at device resolution, which is precisely the resolution
     * nothing else in this picture has.
     *
     * It is the size of the bubble and its tail rather than the size of the
     * stage: the pass below reads two ImageData off it every frame, and a sheet
     * the size of the picture would be a quarter of a million pixels read twice
     * at 30fps for a shape covering a twentieth of it. */
    const paper = document.createElement("canvas");
    const paperCtx = paper.getContext("2d", { willReadFrequently: true });

    /* The ONLY query left in here, and the only one the wipe cares about.
     *
     * The stylesheet still drops out of the sticky layout on two more (narrow
     * and short), and this script no longer repeats them: the wipe reads the
     * TRACK's own passage through the window, and the track is the right box in
     * both geometries — three screens tall while the section is pinned, one
     * ordinary block's worth when it is not. There is nothing left for the CSS
     * and the script to disagree about. */
    const calm = window.matchMedia("(prefers-reduced-motion: reduce)");

    /* The two grounds come from the tokens rather than from a literal, so a
     * palette change reaches the canvas the same way it reaches the CSS. They
     * are the frames' own baked-in backgrounds: paper under the daylight frame,
     * canvas under the night one. */
    const styles = getComputedStyle(document.documentElement);
    const grounds = [
      styles.getPropertyValue("--ink").trim(),
      styles.getPropertyValue("--canvas").trim(),
    ];

    let box = { w: 0, h: 0 };
    let painted = -1;

    /** Sync the canvas backing store to the box and the display density. Returns
     * false while the stage has no size yet — before layout, and while the tab
     * is in a background window. */
    const fit = (): boolean => {
      const { width, height } = stage.getBoundingClientRect();
      if (width <= 0 || height <= 0 || !ctx || !layerCtx || !maskCtx) return false;

      const dpr = Math.min(2, window.devicePixelRatio || 1);
      const w = Math.round(width * dpr);
      const h = Math.round(height * dpr);
      if (view.width !== w || view.height !== h) {
        view.width = w;
        view.height = h;
        layer.width = w;
        layer.height = h;
        painted = -1; // a resized canvas is a cleared canvas
      }
      for (const c of [ctx, layerCtx]) c.setTransform(dpr, 0, 0, dpr, 0, 0);
      if (box.w !== width || box.h !== height) painted = -1;
      box = { w: width, h: height };
      return true;
    };

    /** Where a frame lands on the stage: cover, centred across, biased up.
     *
     * ONE COPY OF THIS ARITHMETIC, used by the painter and by the bubble. They
     * have to agree to the pixel — the tail points at a mouth measured on the
     * photograph, and a second, slightly different crop is how a tail ends up
     * pointing at an ear. */
    const cover = (img: HTMLImageElement) => {
      const scale = Math.max(box.w / img.naturalWidth, box.h / img.naturalHeight);
      const w = img.naturalWidth * scale;
      const h = img.naturalHeight * scale;
      return { x: (box.w - w) / 2, y: (box.h - h) * ANCHOR, w, h };
    };

    /** Draw one frame over the whole stage. */
    const drawFrame = (target: CanvasRenderingContext2D, index: number) => {
      const img = sources[index];
      target.fillStyle = grounds[index];
      target.fillRect(0, 0, box.w, box.h);
      if (!img.complete || img.naturalWidth === 0) return;

      const at = cover(img);
      /* Smoothing off, or the browser resamples the dither into grey mush and
       * the treatment is simply gone. */
      target.imageSmoothingEnabled = false;
      target.drawImage(img, at.x, at.y, at.w, at.h);
    };

    /** 0..1 across one window of a value, clamped at both ends. */
    const span = (value: number, from: number, to: number) =>
      Math.min(1, Math.max(0, (value - from) / (to - from)));

    /** A token's colour as three channels, resolved by the browser rather than
     * parsed here: the tokens are hex today and could be a colour function
     * tomorrow, and the painter has no business caring which. */
    const channels = (value: string): [number, number, number] => {
      const probe = document.createElement("canvas");
      probe.width = probe.height = 1;
      const pc = probe.getContext("2d")!;
      pc.fillStyle = value;
      pc.fillRect(0, 0, 1, 1);
      const [r, g, b] = pc.getImageData(0, 0, 1, 1).data;
      return [r, g, b];
    };

    const INK = channels(grounds[0]);
    const GROUND = channels(grounds[1]);

    /** Print the bubble onto the photograph, in the photograph's own dots.
     *
     * Four steps: set the sentence at dot resolution, put the box on the frame,
     * draw the shape and the type onto the sheet, then turn the sheet into ink
     * with the section's own Bayer matrix.
     *
     * NEITHER ARGUMENT IS AN OPACITY, and that is the point of the rewrite. `on`
     * is the box's COVERAGE and `reveal` is how much of the sentence has been
     * said: a bubble halfway in is half its dots printed, and a word halfway in
     * is a word half its dots are printed of. A fade would put a translucent
     * object over a one-bit picture; this puts more dots on the same paper,
     * which is what the wipe underneath it is already doing.
     *
     * It draws nothing while the night frame has no size — before its decode,
     * and before layout has given the stage a box.
     */
    const printBubble = (on: number, reveal: number) => {
      const sheet = paperCtx;
      const img = sources[1];
      if (!ctx || !sheet || on <= 0) return;
      if (box.w <= 0 || !img.complete || img.naturalWidth === 0) return;

      const frame = cover(img);
      const at = (fx: number, fy: number) => ({
        x: frame.x + fx * frame.w,
        y: frame.y + fy * frame.h,
      });

      /* The photograph's own dot, in CSS pixels: one source pixel as the crop
       * has just scaled it — and where that is too fine to set a sentence on, a
       * WHOLE MULTIPLE of it rather than a floor of its own. A floor would put
       * the bubble on a lattice the picture is not on, and two lattices at odds
       * is the thing this whole rewrite is getting rid of. Rounding to a
       * multiple keeps the bubble in the picture's grid and only prints it in
       * bigger blocks of it. */
      const printed = frame.w / img.naturalWidth;
      const dot = printed * Math.max(1, Math.round(DOT_MIN / printed));

      /* --- The sentence, set in dots ------------------------------------
       * The stylesheet's size is a FLOOR here, not the size. A line has to be
       * at least TYPE_DOTS dots tall to come through the threshold as letters,
       * and how many CSS pixels that is depends on the photograph's dot. Every
       * other measure of the box — its width, its padding, its corner — is
       * taken off the size that comes out, so the box follows its own type. */
      const type = getComputedStyle(bubble);
      const room = (box.w * BUBBLE_MAX_SHARE) / BUBBLE_EMS;
      const size = Math.max(parseFloat(type.fontSize) || 14, Math.min(TYPE_DOTS * dot, room));
      const face = `${type.fontWeight} ${(size / dot).toFixed(2)}px ${type.fontFamily}`;
      const width = Math.max(BUBBLE_MIN_W, box.w * BUBBLE_SHARE, size * BUBBLE_EMS);
      const padX = BUBBLE_PAD_X * size;

      sheet.font = face;
      const space = sheet.measureText(" ").width;
      const inner = (width - 2 * padX) / dot;

      const lines: { text: string; index: number }[][] = [[]];
      let run = 0;
      words.forEach((text, index) => {
        const w = sheet.measureText(text).width;
        const line = lines[lines.length - 1];
        if (line.length && run + space + w > inner) {
          lines.push([{ text, index }]);
          run = w;
          return;
        }
        run += line.length ? space + w : w;
        line.push({ text, index });
      });

      const step = (size * LINE_HEIGHT) / dot;
      const padY = (BUBBLE_PAD_Y * size) / dot;
      const cols = Math.max(1, Math.round(width / dot));
      const rows = Math.max(1, Math.round(padY * 2 + lines.length * step));

      /* --- Where the box sits ------------------------------------------- */
      const corner = at(BUBBLE_AT[0], BUBBLE_AT[1]);
      const right = corner.x;
      const left = right - cols * dot;
      /* The stage clips, so a sentence that wrapped to one more line than the
       * frame has room for would lose its top line rather than overflow. The
       * corner gives way, not the first line. */
      const top = Math.max(BUBBLE_AIR, corner.y - rows * dot);
      const bottom = top + rows * dot;

      /* --- The tail ------------------------------------------------------ */
      const baseY = bottom - dot; // one dot inside, so the two shapes are one silhouette
      const baseX = Math.min(
        Math.max(at(TAIL_AT, 0).x, left + TAIL_HALF + 14),
        right - TAIL_HALF - 14,
      );
      const mouth = at(MOUTH[0], MOUTH[1]);
      let tipY = at(0, TAIL_END).y;
      if (tipY - baseY < TAIL_MIN) tipY = baseY + TAIL_MIN;
      const reach = mouth.y - baseY;
      const tipX = baseX + (reach > 1 ? ((tipY - baseY) / reach) * (mouth.x - baseX) : 0);

      /* --- The sheet ------------------------------------------------------
       * It covers the box and the tail, and its origin is snapped to the
       * FRAME's own dot lattice: the bubble's dots then land on the
       * photograph's instead of half a dot off them. */
      const snapX = (v: number) => frame.x + Math.floor((v - frame.x) / dot) * dot;
      const snapY = (v: number) => frame.y + Math.floor((v - frame.y) / dot) * dot;
      const bleed = (EDGE_FRAY / 2 + 1) * dot;
      const sheetX = snapX(Math.min(left, baseX - TAIL_HALF, tipX) - bleed);
      const sheetY = snapY(top - bleed);
      const sheetW = Math.ceil((Math.max(right, baseX + TAIL_HALF, tipX) + bleed - sheetX) / dot);
      const sheetH = Math.ceil((Math.max(bottom, tipY) + bleed - sheetY) / dot);
      if (sheetW <= 0 || sheetH <= 0) return;

      if (paper.width !== sheetW || paper.height !== sheetH) {
        paper.width = sheetW;
        paper.height = sheetH;
      }
      const px = (v: number) => (v - sheetX) / dot;
      const py = (v: number) => (v - sheetY) / dot;

      /* --- Pass one: the shape ------------------------------------------ */
      sheet.clearRect(0, 0, sheetW, sheetH);
      sheet.fillStyle = "#fff"; // layout-allow: a mask, read for its alpha alone
      sheet.beginPath();
      const radius = Math.max(0, Math.min((BUBBLE_RADIUS * size) / dot, cols / 2, rows / 2));
      if (typeof sheet.roundRect === "function") {
        sheet.roundRect(px(left), py(top), cols, rows, radius);
      } else {
        sheet.rect(px(left), py(top), cols, rows);
      }

      /* Straight down the side facing the mouth, curved on the way back: a
       * wedge with two straight sides is the shape the old burnt-in tail had,
       * and it reads as an arrow rather than as speech. */
      const x1 = px(baseX - TAIL_HALF);
      const x2 = px(baseX + TAIL_HALF);
      const tipPx = px(tipX);
      const tipPy = py(tipY);
      const basePy = py(baseY);
      const dx = x2 - tipPx;
      const dy = basePy - tipPy;
      const len = Math.hypot(dx, dy) || 1;
      const bulge = TAIL_BULGE / dot;
      sheet.moveTo(x1, basePy);
      sheet.lineTo(tipPx, tipPy);
      sheet.quadraticCurveTo(
        (tipPx + x2) / 2 - (dy / len) * bulge,
        (tipPy + basePy) / 2 + (dx / len) * bulge,
        x2,
        basePy,
      );
      sheet.closePath();

      /* Half-covered dots first, then the body over them: the stroke straddles
       * the outline, so filling afterwards takes its inner half back to full
       * coverage and leaves only the dots outside the shape thinned. */
      sheet.globalAlpha = EDGE_COVER;
      sheet.lineWidth = EDGE_FRAY;
      sheet.lineJoin = "round";
      sheet.stroke();
      sheet.globalAlpha = 1;
      sheet.fill();
      const shape = sheet.getImageData(0, 0, sheetW, sheetH);

      /* --- Pass two: the type -------------------------------------------
       * Each word is drawn in a GREY, not at an alpha: the grey is how much of
       * the word has been said, and the alpha is the glyph's own edge. Keeping
       * them in two channels is what lets the combine below hold the letters
       * hard while their coverage builds up. */
      sheet.clearRect(0, 0, sheetW, sheetH);
      sheet.font = face;
      sheet.textBaseline = "middle";
      lines.forEach((line, row) => {
        let x = px(left) + padX / dot;
        const y = py(top) + padY + (row + 0.5) * step;
        for (const { text, index } of line) {
          /* The 1.6 is the overlap — a word is most of the way in before the
           * next one starts, so the sentence arrives as speech rather than as a
           * row of items switching on. */
          const voiced = Math.min(1, Math.max(0, (reveal * words.length - index) * 1.6));
          const v = Math.round(voiced * 255);
          sheet.fillStyle = `rgb(${v}, ${v}, ${v})`;
          sheet.fillText(text, x, y);
          x += sheet.measureText(text).width + space;
        }
      });
      const set = sheet.getImageData(0, 0, sheetW, sheetH);

      /* --- Turn the sheet into ink ---------------------------------------
       * The matrix is indexed in the FRAME's cells rather than the sheet's, so
       * the bubble's dither stays in the same phase as the picture's however
       * the box moves under a resize. */
      const out = sheet.createImageData(sheetW, sheetH);
      const s = shape.data;
      const t = set.data;
      const o = out.data;
      const offX = Math.round((sheetX - frame.x) / dot);
      const offY = Math.round((sheetY - frame.y) / dot);

      for (let y = 0; y < sheetH; y++) {
        const row = BAYER[(y + offY) & 7];
        for (let x = 0; x < sheetW; x++) {
          const i = (y * sheetW + x) * 4;
          const threshold = row[(x + offX) & 7];
          if ((s[i + 3] / 255) * on <= threshold) continue;
          const word = t[i + 3] > TYPE_FLOOR && t[i] / 255 > threshold;
          const [r, g, b] = word ? GROUND : INK;
          o[i] = r;
          o[i + 1] = g;
          o[i + 2] = b;
          o[i + 3] = 255;
        }
      }
      sheet.putImageData(out, 0, 0);

      ctx.imageSmoothingEnabled = false;
      ctx.drawImage(paper, sheetX, sheetY, sheetW * dot, sheetH * dot);
    };

    /** Build the dissolve mask: one pixel per cell, alpha only.
     *
     * A cell belongs to the incoming frame once the edge has passed it by more
     * than its own Bayer threshold.
     *
     * THE EDGE TRAVELS RIGHT TO LEFT, on the maintainer's instruction of
     * 2026-08-29. It starts one band's width off the RIGHT of the picture and
     * ends one band past the LEFT, so the first and last cells get a full turn
     * instead of appearing already finished.
     *
     * It is deliberately NOT tied to which way the section marker happens to be
     * crossing the closing rule underneath it. That alternates down the page,
     * so a wipe that followed it would reverse the moment a section was added
     * above this one — and a picture that changes direction because of
     * something happening in a different section is a picture nobody can
     * explain. */
    const buildMask = (wipe: number) => {
      if (!maskCtx) return;
      const cols = Math.max(1, Math.round(box.w / CELL));
      const rows = Math.max(1, Math.round(box.h / CELL));
      if (mask.width !== cols || mask.height !== rows) {
        mask.width = cols;
        mask.height = rows;
      }

      const band = Math.max(1, cols * BAND);
      const edge = cols + band - wipe * (cols + 2 * band);
      const image = maskCtx.createImageData(cols, rows);
      const data = image.data;

      for (let y = 0; y < rows; y++) {
        const threshold = BAYER[y & 7];
        for (let x = 0; x < cols; x++) {
          const i = (y * cols + x) * 4 + 3;
          data[i] = (x - edge) / band > threshold[x & 7] ? 255 : 0;
        }
      }
      maskCtx.putImageData(image, 0, 0);
    };

    const paint = (wipe: number) => {
      if (!ctx || !layerCtx) return;
      if (!fit()) return;
      if (Math.abs(wipe - painted) < 0.0015) return;
      painted = wipe;

      drawFrame(ctx, 0);
      if (wipe >= 1) {
        drawFrame(ctx, 1);
      } else if (wipe > 0) {
        drawFrame(layerCtx, 1);
        buildMask(wipe);
        layerCtx.globalCompositeOperation = "destination-in";
        layerCtx.imageSmoothingEnabled = false;
        layerCtx.drawImage(mask, 0, 0, box.w, box.h);
        layerCtx.globalCompositeOperation = "source-over";

        ctx.drawImage(layer, 0, 0, box.w, box.h);
      }

      /* The bubble goes on last, because it lies on top of the picture. Both of
       * its clocks are read off the same wipe the dots are, so the words and the
       * picture change together and there is nothing left to keep in step. */
      printBubble(span(wipe, BUBBLE_FROM, BUBBLE_TO), span(wipe, WORDS_FROM, WORDS_TO));
    };

    /** Everything that is text rather than picture. Driven off the same wipe,
     * so the words and the dots change together. */
    const setMode = (mode: string) => {
      if (section.dataset.mode === mode) return;
      section.dataset.mode = mode;
      for (const caption of captions) caption.hidden = caption.dataset.captionFor !== mode;
    };

    const render = (wipe: number) => {
      paint(wipe);
      setMode(wipe >= 0.5 ? "jarvis" : "manual");
    };

    /* --- Where the wipe's value comes from -------------------------------
     *
     * The reader's own scrolling, and nothing else. There used to be a pair of
     * "By hand" / "By voice" buttons in the picture's corner driving it on the
     * layouts with no scroll track; the maintainer removed them on 2026-08-29,
     * so the scrub is now the whole mechanism and the track's own passage
     * through the window is the whole input.
     */
    const fromScroll = (): number => {
      const through = trackProgress(track);
      return span(through, WIPE_FROM, WIPE_TO);
    };

    /* Nothing repaints while the section is off screen. */
    let onScreen = true;
    new IntersectionObserver(([entry]) => (onScreen = entry.isIntersecting), {
      rootMargin: "200px",
    }).observe(section);

    let last = 0;
    let raf = 0;
    const loop = (now: number) => {
      raf = requestAnimationFrame(loop);
      if (!onScreen || now - last < FRAME_MS) return;
      last = now;
      render(calm.matches ? 1 : fromScroll());
    };

    /* The first paint has to wait for the frames to decode; until then the
     * stage shows its paper background rather than an empty box. */
    for (const img of sources) {
      if (!img.complete) {
        img.addEventListener("load", () => (painted = -1), { once: true });
      }
    }

    /* A resize changes the crop and the cell grid, so the next frame has to
     * repaint even at an unchanged wipe. */
    new ResizeObserver(() => (painted = -1)).observe(stage);

    /* And the painter sets the sentence itself, so the web font landing after
     * first paint changes where the line breaks. Nothing else notices that: an
     * unrepainted bubble would keep the fallback face's wrap for the rest of the
     * session, at the fallback's own widths. */
    document.fonts?.ready?.then(() => (painted = -1));

    /* A reader who asked for less motion gets the night frame and its caption,
     * standing still: the state the section is arguing for, the one carrying
     * the speech bubble, and the one whose ground is the page's own. The
     * daylight frame is still in the markup with its own alt text. */
    calm.addEventListener("change", () => (painted = -1));

    raf = requestAnimationFrame(loop);

    /* Stopped on leaving, started again when "Back" restores the page from the
     * back/forward cache — the script does not run a second time, so a loop
     * cancelled for good would leave the wipe frozen. Same as SectionMarker. */
    window.addEventListener("pagehide", () => cancelAnimationFrame(raf));
    window.addEventListener("pageshow", (event) => {
      if (!event.persisted) return;
      cancelAnimationFrame(raf);
      painted = -1;
      raf = requestAnimationFrame(loop);
    });
  }
</script>
