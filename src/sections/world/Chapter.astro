---
/**
 * One chapter of the front page: a stretch of scrolling with one screen pinned
 * inside it, over the 3D scene. `chapter` names its beats in
 * src/world/script.ts; `len` is how many screens of scrolling it takes.
 *
 * Without the scene the same markup is an ordinary section in the flow. The
 * layout of both states is in src/styles/world.css. See docs/world.md.
 */
import Container from "@/components/Container.astro";

interface Props {
  id: string;
  chapter: string;
  len?: number;
  /** The id of the heading that names this chapter. */
  labelledby?: string;
}

const { id, chapter, len = 1.6, labelledby } = Astro.props;
---

<section id={id} class="chapter" data-chapter={chapter} style={`--len: ${len}`} aria-labelledby={labelledby}>
  <div class="chapter__pin">
    <Container width="content" class="chapter__frame">
      <slot />
    </Container>
    <slot name="over" />
  </div>
</section>
