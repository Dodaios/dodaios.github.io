---
/**
 * The first screen: what the product is, one action, and the desk at night
 * behind it. The headline is text in the page, painted before any of the scene
 * has loaded. See docs/hero.md.
 */
import DownloadCta from "@/components/DownloadCta.astro";
import { GitHubMark } from "@/components/logos/GitHubMark";
import counts from "@/data/social-counts.json";
import { REPO } from "@/lib/install";
import { DOCS_URL, TOP_ID } from "@/lib/nav";
import Chapter from "./Chapter.astro";

const stars = new Intl.NumberFormat("en-US").format(counts.platforms.github.value);
---

<Chapter id={TOP_ID} chapter="hero" len={1.7} labelledby="hero-heading">
  <div class="panel" data-ui>
    <p class="eyebrow">Open source · Runs on your machine</p>
    {/* A definition, not a slogan: the reader can repeat what this is after one line. */}
    <h1 id="hero-heading" class="display display--hero">The open-source agent OS for your desktop</h1>
    <p class="lede">
      Dodaios runs your coding agents, browser and apps by voice or chat, on your own machine. Bring your own
      subscription.
    </p>
    <div class="hero3d__actions">
      <DownloadCta class="pill" />
      <p class="hero3d__links">
        <a href={REPO} class="hero3d__link">
          <GitHubMark className="hero3d__link-mark" />
          <span>Star on GitHub</span>
          <span class="hero3d__count">{stars}</span>
        </a>
        <span aria-hidden="true">·</span>
        <a href={DOCS_URL} class="hero3d__link">Read the docs</a>
      </p>
    </div>
  </div>

  <div class="hero3d__cue" slot="over" aria-hidden="true">
    <span class="eyebrow">Scroll to sit down</span>
    <span class="hero3d__cue-line"></span>
  </div>
</Chapter>
