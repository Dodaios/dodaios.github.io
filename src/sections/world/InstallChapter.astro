---
/**
 * Morning: the night scene turns to day while the reader gets the one command
 * that installs the app. The command box and what it does on each system are
 * InstallCommand.astro's; the four steps are the README's, shortened.
 */
import InstallCommand from "@/components/InstallCommand.astro";
import { INSTALL_ID } from "@/lib/nav";
import Chapter from "./Chapter.astro";
---

<Chapter id={INSTALL_ID} chapter="install" len={2.2} labelledby="install-heading">
  <div class="panel" data-ui>
    <p class="eyebrow reveal">Install</p>
    <h2 id="install-heading" class="display reveal" style="--i: 1">Switch it on.</h2>
    <p class="lede reveal" style="--i: 2">
      One command on Windows, macOS or Linux. It builds its own environment, fetches the voice models and opens the
      app.
    </p>
    <div class="install3d__box reveal" style="--i: 3">
      <InstallCommand />
    </div>
    <ol class="install3d__steps reveal" style="--i: 4">
      <li><span><strong>Run the command.</strong> It asks nothing else.</span></li>
      <li>
        <span><strong>Pick a wake word.</strong> Any phrase you like; the assistant takes its name from it.</span>
      </li>
      <li>
        <span><strong>Add a key, or skip it.</strong> Every tier also has a local option that needs none.</span>
      </li>
      <li><span><strong>Say it.</strong></span></li>
    </ol>
  </div>
</Chapter>
