---
/**
 * Nothing hidden: the set dims and shows the lines it is built from, while the
 * copy says the same of the product.
 */
import { GitHubMark } from "@/components/logos/GitHubMark";
import { REPO } from "@/lib/install";
import Chapter from "./Chapter.astro";
---

<Chapter id="open-source" chapter="open" len={1.9} labelledby="oss-heading">
  <div class="panel panel--right" data-ui>
    <p class="eyebrow reveal">Open source · Apache 2.0</p>
    <h2 id="oss-heading" class="display reveal" style="--i: 1">
      Read it before you run it.
      <span class="display__quiet">Every line is on GitHub.</span>
    </h2>
    <p class="lede reveal" style="--i: 2">
      This is the repository the install command pulls from. Open it yourself. Nothing here sits behind a signup, and
      even this scene shows you how it is put together.
    </p>
    <p class="hero3d__actions reveal" style="--i: 3">
      <a class="pill pill--quiet" href={REPO} target="_blank" rel="noopener">
        <GitHubMark className="hero3d__link-mark mr-2" />
        Open the repository
      </a>
    </p>
  </div>
</Chapter>
