---
/**
 * Look up: one light for everyone who starred the repository, and what people
 * have said about the project in public. The quotes, their sources and the
 * rules for adding one are in src/data/voices.ts and docs/section-voices.md.
 */
import LiveCount from "@/components/counters/LiveCount";
import { voices } from "@/data/voices";
import { REPO } from "@/lib/install";
import { SOCIAL_STATS } from "@/lib/socialCounts";
import Chapter from "./Chapter.astro";

/* The figure from the last build, corrected from GitHub when it comes into
 * view. That request is the one the privacy policy describes; if it changes,
 * src/pages/privacy.astro changes in the same commit. */
const github = SOCIAL_STATS.find((stat) => stat.id === "github")!;
---

<Chapter id="stargazers" chapter="stars" len={2.2} labelledby="stars-heading">
  <div class="panel panel--wide stars3d" data-ui>
    <div class="stars3d__head">
      <p class="eyebrow reveal">In the open</p>
      <h2 id="stars-heading" class="reveal" style="--i: 1">
        <span class="stars3d__figure">
          <LiveCount client:visible value={github.value} live={github.live} />
        </span>
        <span class="sr-only"> GitHub stars</span>
      </h2>
      <p class="lede reveal" style="--i: 2">
        people have starred Dodaios on GitHub. Every light above the desk is one of them.
      </p>
      <a class="text-link reveal" style="--i: 3" href={REPO} target="_blank" rel="noopener">
        Add yours <span class="text-link__arrow" aria-hidden="true">→</span>
      </a>
    </div>

    <ul class="voices3d reveal" style="--i: 4" aria-label="What people say">
      {
        voices.map((voice) => (
          <li class="contents">
            <a class="voice3d" href={voice.url} target="_blank" rel="noopener">
              <p class="voice3d__quote">“{voice.text}”</p>
              <p class="voice3d__by">
                {voice.avatar && (
                  <img
                    class="voice3d__avatar"
                    src={voice.avatar}
                    alt=""
                    width="28"
                    height="28"
                    loading="lazy"
                    decoding="async"
                  />
                )}
                <span>
                  {voice.author} · {voice.source}
                </span>
              </p>
            </a>
          </li>
        ))
      }
    </ul>
  </div>
</Chapter>
