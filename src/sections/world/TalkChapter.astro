---
/**
 * Face to face with the mascot: how talking to the app works, and a button
 * that plays it through. The button is a simulation and says so; this page
 * never asks for the microphone.
 */
import Chapter from "./Chapter.astro";

const SAID = "T1, run the tests.";
const REPLY = "On it. I wrote the brief and typed it into pane T1.";
---

<Chapter id="talk" chapter="talk" len={2} labelledby="talk-heading">
  <div class="panel panel--right" data-ui>
    <p class="eyebrow reveal">Voice</p>
    <h2 id="talk-heading" class="display reveal" style="--i: 1">Say it. It gets done.</h2>
    <p class="lede reveal" style="--i: 2">
      Put Claude Code, Codex and OpenCode side by side and tell them what to do. Say “T1, run the tests” and Dodaios
      writes the brief and types it into the right pane, on the subscriptions you already pay for.
    </p>

    <div class="talk reveal" style="--i: 3">
      <button class="talk__hold" type="button" data-talk-hold aria-pressed="false" aria-describedby="talk-note">
        <span class="talk__dot" aria-hidden="true"></span>
        Hold to talk
      </button>
      {/* The lines are typed letter by letter, which is for the eye only: a
          screen reader gets the finished exchange once, from the status line. */}
      <div class="talk__lines" aria-hidden="true">
        <p class="talk__line"><span class="talk__who">You</span><span data-talk-said data-text={SAID}></span></p>
        <p class="talk__line"><span class="talk__who">Dodaios</span><span data-talk-reply data-text={REPLY}></span></p>
      </div>
      <p class="sr-only" role="status" data-talk-status></p>
      <p class="fine" id="talk-note">A simulation. This page never opens your microphone.</p>
    </div>
  </div>
</Chapter>
